# 工作流后端
WORKFLOW_BACKEND=coze
COZE_API_BASE=https://api.coze.cn

COZE_CREDENTIALS_ORDER=secondary

COZE_PRIMARY_AUTH_TYPE=pat
COZE_PRIMARY_API_TOKEN=
COZE_PRIMARY_TOKEN_EXPIRES_AT=YYYY-MM-DD
COZE_PRIMARY_API_BASE=https://api.coze.cn

COZE_SECONDARY_AUTH_TYPE=pat
COZE_SECONDARY_API_TOKEN=
COZE_SECONDARY_TOKEN_EXPIRES_AT=YYYY-MM-DD
COZE_SECONDARY_API_BASE=https://api.coze.cn

COZE_FALLBACK_ON_TIMEOUT=0

# 先注释旧配置，避免继续只走 legacy
# COZE_AUTH_TYPE=pat
# COZE_API_TOKEN=

COZE_TIMEOUT_SECONDS=600
COZE_DRY_RUN=0
BETTER_FRAMEWORK_JSONS_DIR=

# 各阶段 workflow_id，可覆盖 workflow_code_skeleton/config/coze_workflows.yaml
COZE_WORKFLOW_STAGE_01_ID=
COZE_WORKFLOW_STAGE_02_ID=
COZE_WORKFLOW_STAGE_03_ID=
COZE_WORKFLOW_STAGE_04_ID=
COZE_WORKFLOW_STAGE_05_ID=
COZE_WORKFLOW_STAGE_06_ID=
COZE_WORKFLOW_STAGE_07_ID=
COZE_WORKFLOW_STAGE_08_ID=
COZE_WORKFLOW_STAGE_09_ID=
COZE_WORKFLOW_STAGE_10_ID=


# 11/12 是审核修订复合阶段；如需覆盖子工作流，可配置以下变量。
COZE_WORKFLOW_STAGE_11_WRITE_ID=
COZE_WORKFLOW_STAGE_11_REVIEW_ID=
COZE_WORKFLOW_STAGE_11_REWRITE_ID=
COZE_WORKFLOW_STAGE_11_MEMORY_ID=

COZE_WORKFLOW_STAGE_12_WRITE_ID=
COZE_WORKFLOW_STAGE_12_REVIEW_ID=
COZE_WORKFLOW_STAGE_12_REWRITE_ID=
COZE_WORKFLOW_STAGE_12_MEMORY_ID=

# 三段式批处理默认按 5 集推进：all_hooks -> all_dialogues -> all_script
BATCH_SIZE=5

# FastGPT workflow 内部审核/修订常见默认次数；Python 也会读取它作为兜底
MAX_RETRIES_DEFAULT=10