# ========== Coze / 扣子 / 火山工作流配置 ==========
WORKFLOW_BACKEND=coze
# 国内站固定 https://api.coze.cn，不要写 COZE_CN_BASE_URL
COZE_API_BASE=https://api.coze.cn

# 多凭证 fallback：按顺序尝试 primary -> secondary
# 适合比赛场景：一个填学校提供的 token，一个填自己生成的 PAT
COZE_CREDENTIALS_ORDER=primary,secondary

# 主凭证
# token 只填原文，不要加 Bearer
# token 必须完整写在一行，python-dotenv 不会自动拼接多行 token
# 不要把真实 token 提交到 Git；部署到火山时通过环境变量/Secret 注入
COZE_PRIMARY_AUTH_TYPE=pat
COZE_PRIMARY_API_TOKEN=
COZE_PRIMARY_TOKEN_EXPIRES_AT=YYYY-MM-DD
COZE_PRIMARY_API_BASE=https://api.coze.cn

# 备用凭证
# primary 返回 4100/4101 时，可以尝试 secondary
# 4101 表示 token 有效但没有 workflow 权限；4100 表示 token 无效或鉴权失败
COZE_SECONDARY_AUTH_TYPE=pat
COZE_SECONDARY_API_TOKEN=
COZE_SECONDARY_TOKEN_EXPIRES_AT=YYYY-MM-DD
COZE_SECONDARY_API_BASE=https://api.coze.cn

# 是否超时后尝试备用 token
# 默认 0，避免一个工作流已经部分执行后重复跑
COZE_FALLBACK_ON_TIMEOUT=0

# legacy 单 token，仅兼容旧配置，不推荐：
# 如果启用 primary/secondary，建议真实 .env 里不要再填 COZE_API_TOKEN，避免继续走 legacy
COZE_AUTH_TYPE=pat
COZE_API_TOKEN=
COZE_TOKEN_EXPIRES_AT=

COZE_WORKFLOW_CONFIG=
COZE_TIMEOUT_SECONDS=600
COZE_DRY_RUN=0
BETTER_FRAMEWORK_JSONS_DIR=
