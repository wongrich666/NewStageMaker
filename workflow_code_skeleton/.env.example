# 工作流后端
WORKFLOW_BACKEND=coze
ns_api_base=https://api.coze.cn

ns_credentials_order=primary

ns_primary_auth_type=pat
ns_primary_api_token=
COZE_PRIMARY_TOKEN_EXPIRES_AT=2026-07-08
ns_primary_api_base=https://api.coze.cn
ns_fallback_on_timeout=0
ns_fallback_on_timeout=0

# 先注释旧配置，避免继续只走 legacy
# COZE_AUTH_TYPE=pat
# ns_api_token=

ns_timeout_seconds=600
COZE_DRY_RUN=0
BETTER_FRAMEWORK_JSONS_DIR=

# 各阶段 workflow_id，可覆盖 workflow_code_skeleton/config/coze_workflows.yaml
ns_workflow_stage_01_id=
ns_workflow_stage_02_id=
ns_workflow_stage_03_id=
ns_workflow_stage_04_id=
ns_workflow_stage_05_id=
ns_workflow_stage_06_id=
ns_workflow_stage_07_id=
ns_workflow_stage_08_id=
ns_workflow_stage_09_id=
ns_workflow_stage_10_id=


# 11/12 是审核修订复合阶段；如需覆盖子工作流，可配置以下变量。
ns_workflow_stage_11_write_id=
ns_workflow_stage_11_review_id=
ns_workflow_stage_11_rewrite_id=
ns_workflow_stage_11_memory_id=

ns_workflow_stage_12_write_id=
ns_workflow_stage_12_review_id=
ns_workflow_stage_12_rewrite_id=
ns_workflow_stage_12_memory_id=

# 三段式批处理默认按 5 集推进：all_hooks -> all_dialogues -> all_script
BATCH_SIZE=5

# FastGPT workflow 内部审核/修订常见默认次数；Python 也会读取它作为兜底
MAX_RETRIES_DEFAULT=10