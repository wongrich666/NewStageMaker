# 工作流后端：fastgpt 为当前本地编排 + FastGPT workflow API；local 为历史本地旧链路
WORKFLOW_BACKEND=fastgpt
FASTGPT_VARIABLE_MODE=legacy
FASTGPT_BATCH_MODE=local

# 三段式批处理默认按 5 集推进：all_hooks -> all_dialogues -> all_script
BATCH_SIZE=5

# FastGPT workflow 内部审核/修订常见默认次数；Python 也会读取它作为兜底
MAX_RETRIES_DEFAULT=10

# HTTP 成功但输出不可消费时，当前 stage 最多重新调用几次
FASTGPT_STAGE_FORMAT_RETRY_LIMIT=3

# 本地输出 repair 失败后，允许做几次“同阶段本地重跑”兜底
FASTGPT_STAGE_LOCAL_RESTART_RETRIES=1
FASTGPT_OUTPUT_REPAIR_RETRIES=1

# Python 控制的审核/修订循环上限
FASTGPT_STAGE_REVIEW_REVISE_MAX_LOOPS=10

# 历史兼容配置名，当前保留但不再建议作为主要调参项
FASTGPT_STAGE_RETRIES=0

# FastGPT API：请显式填写完整 chat/completions 接口地址，代码不会自动拼接路径
FASTGPT_CHAT_COMPLETIONS_URL=http://127.0.0.1:3000/api/v1/chat/completions
FASTGPT_TIMEOUT=300
FASTGPT_HTTP_RETRIES=2
FASTGPT_HTTP_RETRY_DELAY=1.5

# payload 只做统计和阻断，不会修改正式变量
FASTGPT_STAGE_PAYLOAD_WARN_CHARS=120000
FASTGPT_STAGE_PAYLOAD_HARD_CHARS=240000
FASTGPT_SCRIPT_PAYLOAD_SOFT_LIMIT=180000
FASTGPT_SCRIPT_PAYLOAD_HARD_LIMIT=240000

# detail=false 时代码也应能从 answerNode / choices 拿到正式输出
FASTGPT_CHARACTERS_DETAIL=false
FASTGPT_SCENES_DETAIL=false
FASTGPT_APPEARANCE_ALIAS_GENERATION_DETAIL=false

# 默认不传 chatId 历史上下文；只有显式配置 FASTGPT_CHAT_ID 或 FASTGPT_<STAGE>_CHAT_ID 才启用
# FASTGPT_CHAT_ID=
# FASTGPT_CHAT_ID_PREFIX=scriptmaker

# FastGPT API Key：只放占位符，真实 Key 写入 .env，不要提交
# 未配置单独 stage key 时，会回退使用 FASTGPT_API_KEY
FASTGPT_API_KEY=fastgpt-

# 主链路直连 stage
FASTGPT_FRAMEWORK_API_KEY=fastgpt-
FASTGPT_APPEARANCE_PRE_STRATEGY_API_KEY=fastgpt-
FASTGPT_CONSISTENCY_API_KEY=fastgpt-
FASTGPT_EPISODE_PLAN_NORMALIZE_API_KEY=fastgpt-
FASTGPT_WORLDVIEW_API_KEY=fastgpt-
FASTGPT_CHARACTERS_API_KEY=fastgpt-
FASTGPT_SCENES_API_KEY=fastgpt-
FASTGPT_FINAL_API_KEY=fastgpt-

# 自然语言化 stage
FASTGPT_UNSTRUCTURED_API_KEY=fastgpt-

# appearance 四阶段
FASTGPT_APPEARANCE_ALIAS_WRITING_API_KEY=fastgpt-
FASTGPT_APPEARANCE_ALIAS_REVIEW_API_KEY=fastgpt-
FASTGPT_APPEARANCE_ALIAS_REWRITE_API_KEY=fastgpt-
FASTGPT_APPEARANCE_ALIAS_UNSTRUCTURED_API_KEY=fastgpt-

# hooks 三阶段 + memory
FASTGPT_HOOKS_WRITING_API_KEY=fastgpt-
FASTGPT_HOOKS_REVIEW_API_KEY=fastgpt-
FASTGPT_HOOKS_REWRITE_API_KEY=fastgpt-
FASTGPT_HOOKS_MEMORY_API_KEY=fastgpt-

# dialogues 三阶段 + memory
FASTGPT_DIALOGUES_WRITING_API_KEY=fastgpt-
FASTGPT_DIALOGUES_REVIEW_API_KEY=fastgpt-
FASTGPT_DIALOGUES_REWRITE_API_KEY=fastgpt-
FASTGPT_DIALOGUES_MEMORY_API_KEY=fastgpt-

# script 三阶段 + memory
FASTGPT_SCRIPT_WRITING_API_KEY=fastgpt-
FASTGPT_SCRIPT_REVIEW_API_KEY=fastgpt-
FASTGPT_SCRIPT_REWRITE_API_KEY=fastgpt-
FASTGPT_SCRIPT_MEMORY_API_KEY=fastgpt-

# 三幕十五节拍框架转剧本专用链路：必须独立配置，不回退旧 hooks/dialogues/script
FASTGPT_FRAMEWORK_SCENE_DICTIONARY_API_KEY=
FASTGPT_FRAMEWORK_APPEARANCE_MAPPING_API_KEY=
FASTGPT_FRAMEWORK_ENRICHED_EPISODE_PLAN_API_KEY=
FASTGPT_FRAMEWORK_CAUSAL_CONFLICT_WRITE_API_KEY=
FASTGPT_FRAMEWORK_CAUSAL_CONFLICT_REVIEW_API_KEY=
FASTGPT_FRAMEWORK_CAUSAL_CONFLICT_REWRITE_API_KEY=
FASTGPT_FRAMEWORK_CAUSAL_CONFLICT_MEMORY_API_KEY=
FASTGPT_FRAMEWORK_SCRIPT_WRITE_API_KEY=
FASTGPT_FRAMEWORK_SCRIPT_REVIEW_API_KEY=
FASTGPT_FRAMEWORK_SCRIPT_REWRITE_API_KEY=
FASTGPT_FRAMEWORK_SCRIPT_MEMORY_API_KEY=

# 历史 alias 仍兼容；如果你沿用旧命名，也可以继续配置这些
# FASTGPT_SCRIPT_API_KEY=fastgpt-
# FASTGPT_MEMORY_API_KEY=fastgpt-
# FASTGPT_HOOKS_API_KEY=fastgpt-
# FASTGPT_DIALOGUE_API_KEY=fastgpt-

# 如某个环节需要不同 FastGPT 地址，可按 stage 覆盖完整 URL
# FASTGPT_WORLDVIEW_CHAT_COMPLETIONS_URL=http://127.0.0.1:3000/api/v1/chat/completions
# FASTGPT_SCRIPT_REVIEW_CHAT_COMPLETIONS_URL=http://127.0.0.1:3000/api/v1/chat/completions

# 如某个环节需要不同 timeout，可按 stage 覆盖
# FASTGPT_FRAMEWORK_TIMEOUT=600
FASTGPT_APPEARANCE_ALIAS_WRITING_TIMEOUT=600
FASTGPT_APPEARANCE_ALIAS_REVIEW_TIMEOUT=300
FASTGPT_APPEARANCE_ALIAS_REWRITE_TIMEOUT=600
FASTGPT_APPEARANCE_ALIAS_UNSTRUCTURED_TIMEOUT=300
# FASTGPT_SCRIPT_WRITING_TIMEOUT=600
# FASTGPT_SCRIPT_REVIEW_TIMEOUT=300
# FASTGPT_SCRIPT_MEMORY_TIMEOUT=300

# 辅助工具工作流：hot_review/reskin/punchup/new_framework 仍是单次调用
# 未配置独立 Key 时会回退使用 FASTGPT_API_KEY
FASTGPT_HOT_REVIEW_API_KEY=fastgpt-
FASTGPT_RESKIN_API_KEY=fastgpt-
FASTGPT_PUNCHUP_API_KEY=fastgpt-
FASTGPT_NEW_FRAMEWORK_API_KEY=fastgpt-

# 辅助工具“只换人设 / character_reskin”多阶段 FastGPT 编排链路
# 必须配置以下 12 个专用 key，不再使用 FASTGPT_EDIT_* 或 FASTGPT_SCRIPT_REWRITE_MEMORY_KEY
FASTGPT_COUNT_ACTUAL_EPISODES_KEY=fastgpt-
FASTGPT_WRITE_CHARACTER_PROFILE_KEY=fastgpt-
FASTGPT_REVIEW_CHARACTER_PROFILE_KEY=fastgpt-
FASTGPT_REWRITE_CHARACTER_PROFILE_KEY=fastgpt-
FASTGPT_SORT_CHARACTER_PROFILE_KEY=fastgpt-
FASTGPT_WRITE_CHARACTER_DIALOGUE_KEY=fastgpt-
FASTGPT_REVIEW_CHARACTER_DIALOGUE_KEY=fastgpt-
FASTGPT_REWRITE_CHARACTER_DIALOGUE_KEY=fastgpt-
FASTGPT_WRITE_SCRIPT_BODY_KEY=fastgpt-
FASTGPT_REVIEW_SCRIPT_BODY_KEY=fastgpt-
FASTGPT_REWRITE_SCRIPT_BODY_KEY=fastgpt-
FASTGPT_SCRIPT_MEMORY_KEY=fastgpt-

FASTGPT_CONT_INPUT_NORMALIZE_API_KEY=fastgpt-
FASTGPT_CONT_SCRIPT_NORMALIZE_API_KEY=fastgpt-
FASTGPT_CONT_CONTINUITY_ARCHIVE_API_KEY=fastgpt-
FASTGPT_CONT_WORLDVIEW_BIBLE_API_KEY=fastgpt-
FASTGPT_CONT_CHARACTER_ALIAS_BIBLE_API_KEY=fastgpt-
FASTGPT_CONT_SCENE_PROP_BIBLE_API_KEY=fastgpt-
FASTGPT_CONT_GOAL_CONTRACT_API_KEY=fastgpt-
FASTGPT_CONT_MASTER_OUTLINE_API_KEY=fastgpt-

FASTGPT_CONT_EPISODE_PLAN_API_KEY=fastgpt-
FASTGPT_CONT_EPISODE_PLAN_AUDIT_API_KEY=fastgpt-
FASTGPT_CONT_EPISODE_PLAN_REVISE_API_KEY=fastgpt-

FASTGPT_CONT_HOOK_WRITE_API_KEY=fastgpt-
FASTGPT_CONT_HOOK_AUDIT_API_KEY=fastgpt-
FASTGPT_CONT_HOOK_REVISE_API_KEY=fastgpt-
FASTGPT_CONT_HOOK_MEMORY_API_KEY=fastgpt-

FASTGPT_CONT_DIALOGUE_WRITE_API_KEY=fastgpt-
FASTGPT_CONT_DIALOGUE_AUDIT_API_KEY=fastgpt-
FASTGPT_CONT_DIALOGUE_REVISE_API_KEY=fastgpt-
FASTGPT_CONT_DIALOGUE_MEMORY_API_KEY=fastgpt-

FASTGPT_CONT_SCRIPT_WRITE_API_KEY=fastgpt-
FASTGPT_CONT_SCRIPT_AUDIT_API_KEY=fastgpt-
FASTGPT_CONT_SCRIPT_REVISE_API_KEY=fastgpt-
FASTGPT_CONT_SCRIPT_MEMORY_API_KEY=fastgpt-

FASTGPT_CONT_GLOBAL_AUDIT_API_KEY=fastgpt-
FASTGPT_CONT_FINAL_MERGE_API_KEY=fastgpt-

# 如某个辅助工具需要不同地址，可单独覆盖
# FASTGPT_HOT_REVIEW_CHAT_COMPLETIONS_URL=https://api.fastgpt.in/api/v1/chat/completions
# FASTGPT_RESKIN_CHAT_COMPLETIONS_URL=https://api.fastgpt.in/api/v1/chat/completions
# FASTGPT_PUNCHUP_CHAT_COMPLETIONS_URL=https://api.fastgpt.in/api/v1/chat/completions

# 剧本框架策划工作台：独立链路，不复用旧主剧本生成接口
# 默认会扫描仓库根目录的 BETTER_FRAMEWORK_JSONS；如需改目录，可覆盖
FRAMEWORK_PLANNER_WORKFLOW_DIR=../BETTER_FRAMEWORK_JSONS
# FRAMEWORK_PLANNER_USE_MOCK=false

# 每个阶段都支持：
# 1) 独立 API Key
# 2) 统一 FASTGPT_API_KEY + 独立 WORKFLOW_ID
# 3) 独立 URL / CHAT_COMPLETIONS_URL / BASE_URL
# 只写变量名，不要把真实密钥提交到仓库。
FASTGPT_FRAMEWORK_01_SOURCE_BRIEF_API_KEY=fastgpt-
FASTGPT_FRAMEWORK_01_SOURCE_BRIEF_WORKFLOW_ID=
# FASTGPT_FRAMEWORK_01_SOURCE_BRIEF_URL=https://api.fastgpt.in/api/v1/chat/completions

FASTGPT_FRAMEWORK_02_WORLDVIEW_API_KEY=fastgpt-
FASTGPT_FRAMEWORK_02_WORLDVIEW_WORKFLOW_ID=
# FASTGPT_FRAMEWORK_02_WORLDVIEW_URL=https://api.fastgpt.in/api/v1/chat/completions

FASTGPT_FRAMEWORK_03_CHARACTER_API_KEY=fastgpt-
FASTGPT_FRAMEWORK_03_CHARACTER_WORKFLOW_ID=
# FASTGPT_FRAMEWORK_03_CHARACTER_URL=https://api.fastgpt.in/api/v1/chat/completions

FASTGPT_FRAMEWORK_04_BEAT_API_KEY=fastgpt-
FASTGPT_FRAMEWORK_04_BEAT_WORKFLOW_ID=
# FASTGPT_FRAMEWORK_04_BEAT_URL=https://api.fastgpt.in/api/v1/chat/completions

FASTGPT_FRAMEWORK_05_STORYLINE_API_KEY=fastgpt-
FASTGPT_FRAMEWORK_05_STORYLINE_WORKFLOW_ID=
# FASTGPT_FRAMEWORK_05_STORYLINE_URL=https://api.fastgpt.in/api/v1/chat/completions

FASTGPT_FRAMEWORK_06_GUIDE_API_KEY=fastgpt-
FASTGPT_FRAMEWORK_06_GUIDE_WORKFLOW_ID=
# FASTGPT_FRAMEWORK_06_GUIDE_URL=https://api.fastgpt.in/api/v1/chat/completions

FASTGPT_FRAMEWORK_07_PACKAGE_API_KEY=fastgpt-
FASTGPT_FRAMEWORK_07_PACKAGE_WORKFLOW_ID=
# FASTGPT_FRAMEWORK_07_PACKAGE_URL=https://api.fastgpt.in/api/v1/chat/completions

# 以下是历史 local 后端使用的模型配置。WORKFLOW_BACKEND=fastgpt 时，内容生成由 FastGPT workflow 内部模型决定。
API=deepseek
OLLAMA_HOST=http://localhost:11434/api/chat
OLLAMA_MODEL=your-ollama-model
OLLAMA_API_KEY=your-ollama-api-key

DEEPSEEK_HOST=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-chat

GEMINI_HOST=https://your-gemini-compatible-host/v1/chat/completions
GEMINI _MODEL=your-gemini-model
GEMINI_API_KEY=your-gemini-api-key

CLAUDE_HOST=https://your-claude-compatible-host/v1/chat/completions
CLAUDE_MODEL=your-claude-model
CLAUDE_API_KEY=your-claude-api-key

# 微信公众号配置
WECHAT_APPID=your-wechat-appid
WECHAT_APPSECRET=your-wechat-appsecret
WECHAT_TOKEN=your-wechat-token
WECHAT_TEST_MODE=false


