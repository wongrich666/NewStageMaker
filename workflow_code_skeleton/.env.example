# 腾讯云智能体开发平台：每个已发布的单工作流应用都有独立 AppKey。
# 将控制台“应用发布 > 调用信息”中的 AppKey 填到对应阶段。
TENCENT_WORKFLOW_01_API_KEY=
TENCENT_WORKFLOW_02_API_KEY=
TENCENT_WORKFLOW_03_API_KEY=
TENCENT_WORKFLOW_04_API_KEY=
TENCENT_WORKFLOW_05_API_KEY=
TENCENT_WORKFLOW_06_API_KEY=
TENCENT_WORKFLOW_07_API_KEY=
TENCENT_WORKFLOW_08_API_KEY=
TENCENT_WORKFLOW_09_API_KEY=
TENCENT_WORKFLOW_10_API_KEY=
TENCENT_WORKFLOW_11_01_API_KEY=
TENCENT_WORKFLOW_11_02_API_KEY=
TENCENT_WORKFLOW_11_03_API_KEY=
TENCENT_WORKFLOW_11_04_API_KEY=
TENCENT_WORKFLOW_12_01_API_KEY=
TENCENT_WORKFLOW_12_02_API_KEY=
TENCENT_WORKFLOW_12_03_API_KEY=
TENCENT_WORKFLOW_12_04_API_KEY=
TENCENT_WORKFLOW_HOT_REVIEW_API_KEY=
TENCENT_WORKFLOW_CHARACTER_IMAGE_PROMPT_API_KEY=

# 默认使用腾讯云 ADP HTTP SSE 接口；通常无需修改。
# 如某个工作流的控制台给出独立 URL，可只覆盖该阶段的 API_URL。
TENCENT_ADP_API_URL=http://101.42.184.216/adp/v2/chat
TENCENT_WORKFLOW_V2_INPUT_MODE=workflow_input
# TENCENT_WORKFLOW_01_API_URL=
# TENCENT_WORKFLOW_02_API_URL=
# ...
# TENCENT_WORKFLOW_12_04_API_URL=
# TENCENT_WORKFLOW_HOT_REVIEW_API_URL=
# TENCENT_WORKFLOW_CHARACTER_IMAGE_PROMPT_API_URL=

# 可选请求参数。
TENCENT_WORKFLOW_TIMEOUT_SECONDS=600
TENCENT_WORKFLOW_HTTP_RETRIES=2
TENCENT_WORKFLOW_HTTP_RETRY_DELAY_SECONDS=1.5
# 10 丰富分集计划按集数分批，避免腾讯结束节点约 10000 字符截断；允许 1-10。
TENCENT_WORKFLOW_10_BATCH_SIZE=8
# 11 写作默认逐集生成并在单集内重试；整批仍失败时后台自动恢复后继续下一批。
TENCENT_WORKFLOW_11_WRITE_CHUNK_SIZE=1
TENCENT_WORKFLOW_11_WRITE_MAX_RETRIES=5
TENCENT_WORKFLOW_11_BATCH_MAX_AUTO_RETRIES=2
TENCENT_WORKFLOW_12_BATCH_MAX_AUTO_RETRIES=2
TENCENT_WORKFLOW_12_REVIEW_FORMAT_ATTEMPTS=3
TENCENT_WORKFLOW_TRIGGER_TEXT=执行工作流
TENCENT_WORKFLOW_VISITOR_ID=idea-to-scripts

# 本地运行路径；Windows 启动脚本会自动设置，通常无需填写。
# RUNTIME_DATA_DIR=workflow_code_skeleton/runtime_data
# WRITABLE_ROOT=.
# FLASK_SECRET_KEY=change-me-for-shared-local-testing
