          "value": "{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"schema_version\",\"sitcom_bible\",\"season_topic_matrix\",\"planning_notes\"],\"properties\":{\"schema_version\":{\"type\":\"string\"},\"sitcom_bible\":{\"type\":\"object\"},\"season_topic_matrix\":{\"type\":\"array\",\"items\":{\"type\":\"object\"}},\"planning_notes\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}}}}",
          "debugLabel": "",
