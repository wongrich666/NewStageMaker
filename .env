# 工作流后端：fastgpt 为本地逻辑 + FastGPT 工作流 API；local 为旧 JSON 节点流程
WORKFLOW_BACKEND = fastgpt

# 本地批次大小。按当前契约默认每 5 集一批
BATCH_SIZE = 5
MAX_RETRIES_DEFAULT = 3
FASTGPT_STAGE_RETRIES=0
FASTGPT_BATCH_MODE=local
FASTGPT_VARIABLE_MODE=legacy

# FastGPT API 调用方式
# 这里请直接填写完整的 FastGPT chat/completions 接口地址，代码不会自动补齐路径。
FASTGPT_CHAT_COMPLETIONS_URL=http://192.168.2.203:3000/api/v1/chat/completions
FASTGPT_TIMEOUT=600
FASTGPT_CHARACTERS_TIMEOUT=900
FASTGPT_SCENES_TIMEOUT=600
FASTGPT_APPEARANCE_ALIAS_GENERATION_TIMEOUT=600
FASTGPT_HOOK_WRITE_TIMEOUT=600
FASTGPT_DIALOGUE_WRITE_TIMEOUT=600
FASTGPT_SCRIPT_WRITE_TIMEOUT=900
FASTGPT_HTTP_RETRIES=2
FASTGPT_HTTP_RETRY_DELAY=1.5
# 默认不传 chatId，按无上下文方式调用 FastGPT。
# 只有显式配置 FASTGPT_CHAT_ID 或 FASTGPT_<STAGE>_CHAT_ID 时，才会启用 FastGPT 历史上下文。
# 如果每个环节是独立 FastGPT 应用，请分别配置对应 API Key。
# 未配置单独 Key 时会回退使用 FASTGPT_API_KEY。
