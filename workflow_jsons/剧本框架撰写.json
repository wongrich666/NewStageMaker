, "renderTypeList": [ "settingLLMModel", "reference" ], "label": "common:core.module.input.label.aiModel", "valueType": "string", "value": "deepseek-v4-flash", "debugLabel": "", "toolDescription": "" }, { "key": "temperature", "renderTypeList": [ "hidden" ], "label": "", "valueType": "number", "value": 0.4, "debugLabel": "", "toolDescription": "" }, { "key": "maxToken", "renderTypeList": [ "hidden" ], "label": "", "valueType": "number", "value": 64000, "debugLabel": "", "toolDescription": "" }, { "key": "isResponseAnswerText", "renderTypeList": [ "hidden" ], "label": "", "value": true, "valueType": "boolean", "debugLabel": "", "toolDescription": "" }, { "key": "aiChatQuoteRole", "renderTypeList": [ "hidden" ], "label": "", "valueType": "string", "value": "system", "debugLabel": "", "toolDescription": "" }, { "key": "quoteTemplate", "renderTypeList": [ "hidden" ], "label": "", "valueType": "string", "debugLabel": "", "toolDescription": "" }, { "key": "quotePrompt", "renderTypeList": [ "hidden" ], "label": "", "valueType": "string", "debugLabel": "", "toolDescription": "" }, { "key": "aiChatVision", "renderTypeList": [ "hidden" ], "label": "", "valueType": "boolean", "value": true, "debugLabel": "", "toolDescription": "" }, { "key": "aiChatReasoning", "renderTypeList": [ "hidden" ], "label": "", "valueType": "boolean", "value": true, "debugLabel": "", "toolDescription": "" }, { "key": "aiChatTopP", "renderTypeList": [ "hidden" ], "label": "", "valueType": "number", "debugLabel": "", "toolDescription": "" }, { "key": "aiChatStopSign", "renderTypeList": [ "hidden" ], "label": "", "valueType": "string", "debugLabel": "", "toolDescription": "" }, { "key": "aiChatResponseFormat", "renderTypeList": [ "hidden" ], "label": "", "valueType": "string", "value": "json_object", "debugLabel": "", "toolDescription": "" }, { "key": "aiChatJsonSchema", "renderTypeList": [ "hidden" ], "label": "", "valueType": "string", "debugLabel": "", "toolDescription": "" }, { "key": "systemPrompt", "renderTypeList": [ "textarea", "reference" ], "maxLength": 100000, "isRichText": true, "valueType": "string", "label": "common:core.ai.Prompt", "value": "你是“长篇连续剧剧本框架结构化生成器”。\n\n你的唯一任务：\n根据输入变量，一次性生成完整剧本框架，并且只输出一个合法 JSON 对象。\n\n你可用输入：\n- 用户想要的故事：{{$VARIABLE_NODE_ID.wjmWDwbg$}}\n- 角色数量：{{$VARIABLE_NODE_ID.tsv3A9ac$}}\n- 总集数：{{$VARIABLE_NODE_ID.bFgF0xfY$}}\n\n禁止使用或等待以下输入：\n- 服装版本需求\n- 命名偏好\n\n如果用户信息不足，你必须自行合理补全，但不能偏离“用户想要的故事”。\n\n# 输出强约束\n\n你只能输出一个 JSON 对象。\n禁止输出 markdown。\n禁止输出 ```json。\n禁止输出解释、流程说明、寒暄、已完成。\n禁止在 JSON 外输出任何字符。\n\nJSON 顶层必须且只能包含以下 5 个字段：\n\n{\n \"script_title\": \"剧本标题具体内容\",\n \"story_outline\": {\n \"opening\": \"开局与主角初始处境\",\n \"inciting_incident\": \"核心事件触发点\",\n \"early_goal\": \"前期目标\",\n \"middle_escalation\": \"中期升级\",\n \"relationship_changes\": \"人物关系变化\",\n \"larger_crisis_or_truth\": \"更大危机或真相\",\n \"late_direction\": \"后期走向\",\n \"final_climax\": \"最终高潮\",\n \"ending_resolution\": \"结局收束\",\n \"theme\": \"故事主题\"\n },\n \"user_characters\": [\n {\n \"name\": \"角色姓名\",\n \"role_type\": \"主角/反派/配角/盟友/亲属等\",\n \"identity\": \"身份定位\",\n \"personality\": \"性格特点\",\n \"core_desire\": \"核心欲望\",\n \"deep_motivation\": \"深层动机\",\n \"strengths\": \"擅长能力或特长\",\n \"weaknesses\": \"角色弱点\",\n \"appearance_anchor\": \"稳定外貌识别锚点\",\n \"relationship_to_protagonist\": \"与主角关系\",\n \"relationships_with_others\": \"与其他主要角色关系\",\n \"growth_arc\": \"成长线\",\n \"plot_function\": \"主线作用\"\n }\n ],\n \"user_scenes\": {\n \"era_background\": \"时代背景\",\n \"world_state\": \"世界状态或社会环境\",\n \"core_locations\": [\n {\n \"name\": \"核心场景名称\",\n \"function\": \"剧情功能\",\n \"conflict_soil\": \"这里能持续产生什么冲突\",\n \"key_characters\": [\"常出现角色\"]\n }\n ],\n \"rules\": \"行动规则/生存规则/行业规则\",\n \"danger_sources\": \"危险来源\",\n \"resource_or_stakes\": \"资源体系或利益争夺点\",\n \"power_distribution\": \"势力分布\",\n \"special_rules\": \"能力体系或特殊规则，没有则写空字符串\",\n \"overall_atmosphere\": \"整体氛围\"\n },\n \"episode_plan\": [\n {\n \"episode\": 1,\n \"title\": \"第1集标题\",\n \"main_plot\": \"本集主线剧情\",\n \"conflicts\": [\n \"冲突1：具体冲突内容\",\n \"冲突2：具体冲突内容\",\n \"冲突3：具体冲突内容\"\n ],\n \"ending_hook\": \"本集结尾钩子\"\n }\n ]\n}\n\n# 内容要求\n\n1. script_title 必须是一个纯标题，不要副标题，不要说明。\n2. story_outline 必须覆盖完整长篇剧情，不要写成分集。\n3. user_characters 的角色数量必须尽量等于“角色数量”输入。\n4. user_scenes 必须写清楚世界、舞台、规则、危险、资源和冲突土壤。\n5. episode_plan 必须完整覆盖第 1 集到第 {{$VARIABLE_NODE_ID.bFgF0xfY$}} 集。\n6. episode_plan 不允许缺集、跳集、重复集数。\n7. 每一集 conflicts 数组必须至少 3 条。\n8. 每条冲突都必须是具体事件冲突，禁止写“矛盾升级”“危机浮现”这类空话。\n9. ending_hook 必须是具体可拍的钩子。\n10. 所有字段都必须非空；没有特殊规则时 special_rules 可以为空字符串。\n11. JSON 必须能被 Python json.loads 直接解析。", "description": "common:core.app.tip.systemPromptTip", "placeholder": "common:core.app.tip.chatNodeSystemPromptTip", "debugLabel": "", "toolDescription": "" }, { "key": "history", "renderTypeList": [ "numberInput", "reference" ], "valueType": "chatHistory", "label": "common:core.module.input.label.chat history", "required": true, "min": 0, "max": 50, "value": 0, "description": "workflow:max_dialog_rounds", "debugLabel": "", "toolDescription": "" }, { "key": "quoteQA", "renderTypeList": [ "settingDatasetQuotePrompt" ], "label": "", "debugLabel": "知识库引用", "description": "", "valueType": "datasetQuote", "toolDescription": "" }, { "key": "fileUrlList", "renderTypeList": [ "reference", "input" ], "label": "app:workflow.user_file_input", "valueType": "arrayString", "value": [], "debugLabel": "文件链接", "description": "app:workflow.user_file_input_desc", "toolDescription": "" }, { "key": "userChatInput", "renderTypeList": [ "reference", "textarea" ], "valueType": "string", "label": "workflow:user_question", "required": true, "value": "严格根据全局变量生成剧本框架结构化 JSON。只输出 JSON，不要解释。", "selectedTypeIndex": 1, "toolDescription": "用户问题", "debugLabel": "" } ], "outputs": [ { "id": "history", "key": "history", "required": true, "label": "common:core.module.output.label.New context", "description": "将本次回复内容拼接上历史记录，作为新的上下文返回", "valueType": "chatHistory", "valueDesc": "{\n obj: System | Human | AI;\n value: string;\n}[]", "type": "static" }