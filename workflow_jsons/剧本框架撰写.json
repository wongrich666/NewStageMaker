pdateList", "valueType": "any", "label": "", "renderTypeList": [ "hidden" ], "value": [ { "variable": [ "VARIABLE_NODE_ID", "ybZX4RYQ" ], "value": [ "tpCoreScenes001", "core_scene_content" ], "valueType": "string", "renderType": "reference" } ], "debugLabel": "核心场景正文", "toolDescription": "目标变量=ybZX4RYQ；来源工具参数=tpCoreScenes001.core_scene_content；只写入这一项。" } ], "outputs": [] }, { "nodeId": "gzk5KjE2Aa3hXVpq", "name": "写入分集计划变量", "intro": "把上游自定义工具变量写入 internal 变量 ewp4kRma。仅写入该变量，不处理其他内容。", "avatar": "core/workflow/template/variableUpdate", "flowNodeType": "variableUpdate", "showStatus": false, "position": { "x": 2552, "y": 780 }, "inputs": [ { "key": "updateList", "valueType": "any", "label": "", "renderTypeList": [ "hidden" ], "value": [ { "variable": [ "VARIABLE_NODE_ID", "ewp4kRma" ], "value": [ "tpEpisodePlan001", "episode_plan_content" ], "valueType": "string", "renderType": "reference" } ], "debugLabel": "分集计划正文", "toolDescription": "目标变量=ewp4kRma；来源工具参数=tpEpisodePlan001.episode_plan_content；只写入这一项。" } ], "outputs": [] }, { "nodeId": "mRrn87NgOuOx6zCH", "name": "剧情框架拆分总控智能体", "intro": "先完成整体剧情框架规划，并同步埋入后续服装版本映射所需的阶段、状态、场景与命名依据；再按固定顺序调用5个自定义工具变量节点，把内容分别写入5个 internal 变量。", "avatar": "core/workflow/template/toolCall", "flowNodeType": "tools", "showStatus": true, "position": { "x": 1275, "y": -1785 }, "version": "4.9.2", "inputs": [ { "key": "model", "renderTypeList": [ "settingLLMModel", "reference" ], "label": "common:core.module.input.label.aiModel", "valueType": "string", "debugLabel": "", "toolDescription": "", "value": "deepseek-chat" }, { "key": "temperature", "renderTypeList": [ "hidden" ], "label": "", "valueType": "number", "debugLabel": "", "toolDescription": "" }, { "key": "maxToken", "renderTypeList": [ "hidden" ], "label": "", "valueType": "number", "debugLabel": "", "toolDescription": "" }, { "key": "isResponseAnswerText", "renderTypeList": [ "hidden" ], "label": "", "value": true, "valueType": "boolean", "debugLabel": "", "toolDescription": "" }, { "key": "aiChatVision", "renderTypeList": [ "hidden" ], "label": "", "valueType": "boolean", "value": true, "debugLabel": "", "toolDescription": "" }, { "key": "aiChatReasoning", "renderTypeList": [ "hidden" ], "label": "", "valueType": "boolean", "value": true, "debugLabel": "", "toolDescription": "" }, { "key": "aiChatTopP", "renderTypeList": [ "hidden" ], "label": "", "valueType": "number", "debugLabel": "", "toolDescription": "" }, { "key": "aiChatStopSign", "renderTypeList": [ "hidden" ], "label": "", "valueType": "string", "debugLabel": "", "toolDescription": "" }, { "key": "aiChatResponseFormat", "renderTypeList": [ "hidden" ], "label": "", "valueType": "string", "debugLabel": "", "toolDescription": "" }, { "key": "aiChatJsonSchema", "renderTypeList": [ "hidden" ], "label": "", "valueType": "string", "debugLabel": "", "toolDescription": "" }, { "key": "useAgentSandbox", "renderTypeList": [ "switch" ], "label": "app:use_agent_sandbox", "description": "app:use_computer_desc", "valueType": "boolean", "value": false, "debugLabel": "", "toolDescription": "" }, { "key": "systemPrompt", "renderTypeList": [ "textarea", "reference" ], "maxLength": 100000, "isRichText": true, "valueType": "string", "label": "common:core.ai.Prompt", "description": "common:core.app.tip.systemPromptTip", "placeholder": "common:core.app.tip.chatNodeSystemPromptTip", "value": "你是“长篇连续剧剧情框架拆分总控智能体”。\n\n你的唯一职责：\n先完成整体剧情框架规划，再严格按顺序调用 5 个写入工具，把结果分别写入对应变量。\n\n你可用输入只有：\n- 用户想要的故事：{{$VARIABLE_NODE_ID.wjmWDwbg$}}\n- 角色数量：{{$VARIABLE_NODE_ID.tsv3A9ac$}}\n- 总集数：{{$VARIABLE_NODE_ID.bFgF0xfY$}}\n- 服装版本需求：{{$VARIABLE_NODE_ID.q8LmN2vP$}}\n- 命名偏好：{{$VARIABLE_NODE_ID.m3UxJ8pD$}}\n\n你不得要求用户补充信息。\n若信息不足，必须自行合理补全，但不能偏离“用户想要的故事”和“服装版本需求”。\n\n# 总目标\n围绕“用户想要的故事”“角色数量”“总集数”“服装版本需求”，完成一个可供后续继续创作的长篇连续剧框架，并拆分成以下 5 部分：\n1. 剧本标题\n2. 故事大纲\n3. 人物小传\n4. 核心场景\n5. 分集计划\n\n注意：\n本阶段不直接输出服装版本映射表，但你必须在以上 5 部分中提前埋入后续服装版本映射需要的依据，让后续阶段能判断：\n- 哪些角色可能需要多套服装版本\n- 为什么需要切换\n- 由什么触发切换\n- 触发更接近集数阶段、场景类型、身份状态、职业状态、生活状态，还是重大剧情事件\n- 后续人物命名应该偏向什么风格\n\n# 执行规则\n1. 你必须先完成整体规划，再调用工具。\n2. 你必须调用且仅调用下面 5 个工具，各调用 1 次。\n3. 调用顺序固定，不能改变：\n 第1步：提交剧本标题内容\n 第2步：提交故事大纲内容\n 第3步：提交人物小传内容\n 第4步：提交核心场景内容\n 第5步：提交分集计划内容\n1. 每个工具只能接收属于它自己的内容，禁止混写。\n2. 每次工具调用都必须填写完整内容，不得写“见上文”“同前”“略”。\n3. 五部分内容必须彼此一致，不能互相冲突。\n4. 总集数固定为 {{$VARIABLE_NODE_ID.bFgF0xfY$}} 集。\n5. 分集计划必须完整覆盖第 1 集到第 {{$VARIABLE_NODE_ID.bFgF0xfY$}} 集，不能缺集、跳集、断主线。\n6. 每集必须至少有 3 个冲突点。\n7. 不得把故事大纲写成人物小传，不得把人物小传写成核心场景，不得把核心场景写成分集计划。\n8. 本阶段只负责规划和写入，不负责解释流程。\n\n# 五部分内容要求\n\n一、剧本标题\n- 只写一个适合整部剧的标题\n- 必须是纯标题\n- 不要副标题\n- 不要剧情摘要\n- 不要说明文字\n- 标题要与题材、主线冲突、人物气质相符\n\n二、故事大纲\n- 写整体剧情梗概\n- 必须包含：开局、主角初始处境、核心事件触发点、前期目标、中期升级、人物关系变化、更大危机或真相、后期走向、最终高潮、结局收束、故事主题\n- 若人物存在明显的身份状态、职业状态、生活状态、关系状态变化，并会影响后续服装版本命名，必须写清这些阶段变化\n- 这是整体剧情脉络，不是人物表，不是场景表，不是逐集计划\n\n三、人物小传\n- 按角色数量设计主要角色\n- 每个角色必须包含：姓名、身份定位、性格特点、核心欲望、深层动机、擅长能力或特长、角色弱点、与主角关系、与其他主要角色关系、成长线、主线作用\n- 还要补足：稳定外貌识别锚点、常见活动状态、身份状态、职业状态、哪些状态下容易形成不同服装版本\n- 若用户给了服装版本需求，要把换装逻辑、适用阶段和命名倾向埋进去\n- 只写人物，不写逐集剧情\n\n四、核心场景\n- 写世界设定与核心场景舞台\n- 必须包含：时代背景、世界状态或社会环境、核心场景区域、生存规则或行动规则、危险来源、资源体系或利益争夺点、势力分布、能力体系或特殊规则、整体氛围、适合持续推进剧情的冲突土壤\n- 还要补足：会高频触发人物服装切换的场景类型、环境条件、时间条件、社会身份要求或行动要求\n- 这是舞台和规则，不是人物小传，不是逐集计划\n\n五、分集计划\n- 必须先做阶段划分，再写完整分集计划\n- 每一集都必须包含：\n 第X集：\n 主线剧情：\n 冲突点（至少三个）：\n 1）\n 2）\n 3）\n 结尾钩子：\n- 分集计划必须完整覆盖第1集到第{{$VARIABLE_NODE_ID.bFgF0xfY$}}集\n- 若某一集或某一阶段发生会影响后续服装版本命名的变化，例如身份切换、职业切换、潜伏伪装、关系破裂、环境切换、昼夜变化、季节变化、场景重心变化，必须明确写出\n- 若用户有明确“几集到几集穿哪类状态”的需求，必须把依据埋进阶段划分和对应集数中，但不要直接写成服装映射表\n\n# 自动补全要求\n你必须自动识别题材倾向，并补足对应的剧情土壤、身份状态、场景条件和服装切换依据。\n\n# 命名偏好处理\n- 若命名偏好为空，默认后续服装版本命名风格为“角色名【场景/状态】”\n- 若命名偏好不为空，你必须让人物小传、核心场景、分集计划中的相关表述与该命名风格保持一致\n- 本阶段不直接输出别名表，但要给下游留下足够清晰的命名依据\n\n\n# 契约输出强约束\n\n本工作流最终必须满足 Python 阶段契约字段：\n\n{\n \"script_title\": \"剧本标题\",\n \"story_outline\": \"故事大纲\",\n \"user_characters\": \"人物小传\",\n \"user_scenes\": \"核心场景\",\n \"episode_plan\": \"分集计划\"\n}\n\n你不能只在普通回复里输出内容。\n你必须通过工具调用分别写入以下 5 个工具参数：\n\n1. 提交剧本标题内容.script_title_content\n2. 提交故事大纲内容.story_outline_content\n3. 提交人物小传内容.character_bios_content\n4. 提交核心场景内容.core_scene_content\n5. 提交分集计划内容.episode_plan_content\n\n禁止跳过任何一个工具。\n禁止把五部分合并写进一个工具。\n禁止输出 markdown 代码块。\n禁止输出“已完成”“见上文”“略”。\n禁止只回答自然语言而不调用工具。\n\n如果你无法确认内容，也必须自行合理补全，然后完成 5 次工具调用。", "debugLabel": "", "toolDescription": "" }, { "key": "history", "renderTypeList": [ "numberInput", "reference" ], "valueType": "chatHistory", "label": "common:core.module.input.label.chat history", "description": "workflow:max_dialog_rounds", "required": true, "min": 0, "max": 50, "value": 0, "debugLabel": "", "toolDescription": "" }, { "key": "fileUrlList", "renderTypeList": [ "reference", "input" ], "label": "app:workflow.user_file_input", "debugLabel": "文件链接", "description": "app:workflow.user_file_input_desc", "valueType": "arrayString", "value": [], "toolDescription": "" }, { "key": "userChatInput", "renderTypeList": [ "reference", "textarea" ], "valueType": "string", "label": "workflow:user_question", "toolDescription": "user question", "required": true, "value": "严格根据全局变量完成整体规划，并按固定顺序调用4个写入工具。不要直接输出全文。", "selectedTypeIndex": 1, "debugLabel": "" } ], "outputs": [ { "id": "answerText", "key": "answerText", "label": "common:core.module.output.label.Ai response content", "description": "将在 stream 回复完毕后触发", "valueType": "string", "type": "static", "valueDesc": "" }, { "id": "system_error_text", "key": "system_error_text", "type": "error", "valueType": "string", "label": "workflow:error_text", "valueDesc": "", "description": "" } ], "catchError": false }, { "nodeId": "tpScriptTitle001", "name": "提交剧本标题内容", "intro": "该模块需要配合工具调用使用。可以自定义工具调用参数，并把内容传递到指定变量写入节点。", "avatar": "core/workflow/template/toolParams", "flowNodeType": "toolParams", "position": { "x": -450, "y": -30 }, "inputs": [ { "valueType": "string", "renderTypeList": [ "reference" ], "key": "script_title_content", "label": "剧本标题正文", "toolDescription": "只填写“剧本标题”本身。必须是一个完整、可直接使用的标题字符串。禁止写故事大纲、人物小传、核心场景、分集计划、说明文字或JSON。", "required": true, "canEdit": true, "customInputConfig": { "selectValueTypeList": [ "string" ], "showDescription": true }, "enum": "", "description": "剧本标题正文。