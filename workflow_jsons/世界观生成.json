"label": "common:core.module.input.label.aiModel", "valueType": "string", "renderTypeList": [ "settingLLMModel", "reference" ], "value": "deepseek-reasoner", "debugLabel": "", "toolDescription": "" }, { "key": "temperature", "label": "", "valueType": "number", "renderTypeList": [ "hidden" ], "debugLabel": "", "toolDescription": "" }, { "key": "maxToken", "label": "", "valueType": "number", "renderTypeList": [ "hidden" ], "debugLabel": "", "toolDescription": "" }, { "key": "isResponseAnswerText", "label": "", "valueType": "boolean", "renderTypeList": [ "hidden" ], "value": false, "debugLabel": "", "toolDescription": "" }, { "key": "aiChatQuoteRole", "label": "", "valueType": "string", "renderTypeList": [ "hidden" ], "value": "system", "debugLabel": "", "toolDescription": "" }, { "key": "quoteTemplate", "label": "", "valueType": "string", "renderTypeList": [ "hidden" ], "debugLabel": "", "toolDescription": "" }, { "key": "quotePrompt", "label": "", "valueType": "string", "renderTypeList": [ "hidden" ], "debugLabel": "", "toolDescription": "" }, { "key": "aiChatVision", "label": "", "valueType": "boolean", "renderTypeList": [ "hidden" ], "value": true, "debugLabel": "", "toolDescription": "" }, { "key": "aiChatReasoning", "label": "", "valueType": "boolean", "renderTypeList": [ "hidden" ], "value": true, "debugLabel": "", "toolDescription": "" }, { "key": "aiChatTopP", "label": "", "valueType": "number", "renderTypeList": [ "hidden" ], "debugLabel": "", "toolDescription": "" }, { "key": "aiChatStopSign", "label": "", "valueType": "string", "renderTypeList": [ "hidden" ], "debugLabel": "", "toolDescription": "" }, { "key": "aiChatResponseFormat", "label": "", "valueType": "string", "renderTypeList": [ "hidden" ], "debugLabel": "", "toolDescription": "", "value": "json_object" }, { "key": "aiChatJsonSchema", "label": "", "valueType": "string", "renderTypeList": [ "hidden" ], "debugLabel": "", "toolDescription": "", "value": "{\"type\": \"object\", \"additionalProperties\": false, \"required\": [\"genre_and_tone\", \"required_era_or_setting\", \"setting_constraints\", \"required_scenes\", \"required_characters\", \"plot_support_points\", \"forbidden_deviations\"], \"properties\": {\"genre_and_tone\": {\"type\": \"string\", \"minLength\": 5}, \"required_era_or_setting\": {\"type\": \"string\", \"minLength\": 2}, \"setting_constraints\": {\"type\": \"array\", \"minItems\": 3, \"items\": {\"type\": \"string\", \"minLength\": 3}}, \"required_scenes\": {\"type\": \"array\", \"minItems\": 3, \"items\": {\"type\": \"string\", \"minLength\": 3}}, \"required_characters\": {\"type\": \"array\", \"minItems\": 3, \"items\": {\"type\": \"string\", \"minLength\": 3}}, \"plot_support_points\": {\"type\": \"array\", \"minItems\": 3, \"items\": {\"type\": \"string\", \"minLength\": 3}}, \"forbidden_deviations\": {\"type\": \"array\", \"minItems\": 3, \"items\": {\"type\": \"string\", \"minLength\": 3}}}}" }, { "key": "systemPrompt", "label": "common:core.ai.Prompt", "valueType": "string", "isRichText": true, "placeholder": "common:core.app.tip.chatNodeSystemPromptTip", "maxLength": 100000, "renderTypeList": [ "textarea", "reference" ], "value": "你是“用户内容提取器”。\n\n你的任务是根据用户输入的故事大纲、核心场景、人物小传和分集计划，提炼出一份“世界观审核基准”。\n\n注意：\n- 你的任务不是重写故事\n- 你的任务不是扩写剧情\n- 你的任务是提炼出后续“世界观生成”和“世界观审核”必须遵守的边界条件\n- 结果必须简洁、明确、可执行\n- 所有内容使用中文\n- 只输出合法 JSON\n- 不要输出 JSON 之外的任何文字\n- 不要使用 markdown 代码块\n- 所有字段必须填写\n- 所有数组字段至少输出 3 条内容\n\n【故事大纲】\n{{$VARIABLE_NODE_ID.ayxWwSpE$}}\n\n【核心场景】\n{{$VARIABLE_NODE_ID.rxmvq2lS$}}\n\n【人物小传】\n{{$VARIABLE_NODE_ID.yYYOuumm$}}\n\n【分集计划】\n{{$VARIABLE_NODE_ID.pxtQY7p2$}}\n提炼要求：\n1. 总结题材、风格和整体基调\n2. 明确必须满足的时代或背景类型\n3. 提炼世界观不能偏离的设定边界\n4. 提炼世界观必须支撑成立的核心场景\n5. 提炼世界观必须兼容的关键人物类型\n6. 提炼世界观必须支撑的剧情方向\n7. 明确禁止偏离的错误方向\n\n再次强调：最终回复必须且只能是一个合法 JSON 对象，禁止输出任何解释、标题、注释、代码块标记或多余文本。请严格输出为以下 JSON 结构：\n{\n \"genre_and_tone\": \"题材、风格、情绪基调的简洁总结\",\n \"required_era_or_setting\": \"必须符合的时代或背景类型，例如古风架空、古代宫廷、现代都市等\",\n \"setting_constraints\": [\n \"世界观必须遵守的设定边界1\",\n \"世界观必须遵守的设定边界2\",\n \"世界观必须遵守的设定边界3\"\n ],\n \"required_scenes\": [\n \"必须能成立的核心场景1\",\n \"必须能成立的核心场景2\",\n \"必须能成立的核心场景3\"\n ],\n \"required_characters\": [\n \"必须兼容的关键人物或人物类型1\",\n \"必须兼容的关键人物或人物类型2\",\n \"必须兼容的关键人物或人物类型3\"\n ],\n \"plot_support_points\": [\n \"世界观必须支撑的剧情方向1\",\n \"世界观必须支撑的剧情方向2\",\n \"世界观必须支撑的剧情方向3\"\n ],\n \"forbidden_deviations\": [\n \"明确禁止偏离的方向1\",\n \"明确禁止偏离的方向2\",\n \"明确禁止偏离的方向3\"\n ]\n}\n\n再次强调：你的最终回复必须且只能是一个合法 JSON 对象，禁止输出任何解释、标题、注释、代码块标记或多余文本。\n\n【强制格式兜底】\n- 最终输出必须能被 JSON.parse 直接解析。\n- 禁止输出 markdown、代码块、解释、标题、注释。\n- 禁止把字段名翻译成中文，禁止增加非契约字段，禁止遗漏字段。\n- 字符串字段不得为空；数组字段不得为空，且不得包含空字符串。\n", "debugLabel": "", "description": "common:core.app.tip.systemPromptTip", "toolDescription": "" }, { "key": "history", "label": "common:core.module.input.label.chat history", "valueType": "chatHistory", "required": true, "max": 50, "min": 0, "renderTypeList": [ "numberInput", "reference" ], "value": 0, "debugLabel": "", "description": "workflow:max_dialog_rounds", "toolDescription": "" }, { "key": "quoteQA", "label": "", "valueType": "datasetQuote", "renderTypeList": [ "settingDatasetQuotePrompt" ], "debugLabel": "知识库引用", "description": "", "toolDescription": "" }, { "key": "fileUrlList", "label": "app:workflow.user_file_input", "valueType": "arrayString", "renderTypeList": [ "reference", "input" ], "value": [ [ "448745", "userFiles" ] ], "debugLabel": "文件链接", "description": "app:workflow.user_file_input_desc", "toolDescription": "" }, { "key": "userChatInput", "label": "workflow:user_question", "valueType": "string", "required": true, "selectedTypeIndex": 1, "renderTypeList": [ "reference", "textarea" ], "value": "按照提示词完成用户内容提取任务即可。", "debugLabel": "", "toolDescription": "用户问题" } ], "outputs": [ { "id": "history", "key": "history", "type": "static", "valueType": "chatHistory", "valueDesc": "{\n obj: System | Human | AI;\n value: string;\n}[]", "label": "common:core.module.output.label.New context", "description": "将本次回复内容拼接上历史记录，作为新的上下文返回", "required": true }, { "id": "answerText", "key": "answerText", "type": "static", "valueType": "string", "valueDesc": "", "label": "common:core.module.output.label.Ai response content", "description": "将在 stream 回复完毕后触发", "required": true }, { "id": "reasoningText", "key": "reasoningText", "type": "static", "valueType": "string", "valueDesc": "", "label": "workflow:reasoning_content", "description": "", "required": false, "invalid": false }, { "id": "system_error_text", "key": "system_error_text", "type": "error", "valueType": "string", "valueDesc": "", "label": "workflow:error_text", "description": "" } ], "catchError": false }, { "nodeId": "hHCb00c6JSlNKdrf", "name": "世界观生成编剧", "intro": "世界观生成编剧A负责根据用户已经提供的基础设定，生成完整世界观。", "avatar": "core/workflow/template/aiChat", "flowNodeType": "chatNode", "showStatus": true, "position": { "x": 195, "y": -4335 }, "version": "4.9.7", "inputs": [ { "key": "model", "label": "common:core.module.input.label.aiModel", "valueType": "string", "renderTypeList": [ "settingLLMModel", "reference" ], "value": "deepseek-reasoner", "debugLabel": "", "toolDescription": "" }, { "key": "temperature", "label": "", "valueType": "number", "renderTypeList": [ "hidden" ], "debugLabel": "", "toolDescription": "" }, { "key": "maxToken", "label": "", "valueType": "number", "renderTypeList": [ "hidden" ], "debugLabel": "", "toolDescription": "" }, { "key": "isResponseAnswerText", "label": "", "valueType": "boolean", "renderTypeList": [ "hidden" ], "value": false, "debugLabel": "", "toolDescription": "" }, { "key": "aiChatQuoteRole", "label": "", "valueType": "string", "renderTypeList": [ "hidden" ], "value": "system", "debugLabel": "", "toolDescription": "" }, { "key": "quoteTemplate", "label": "", "valueType": "string", "renderTypeList": [ "hidden" ], "debugLabel": "", "toolDescription": "" }, { "key": "quotePrompt", "label": "", "valueType": "string", "renderTypeList": [ "hidden" ], "debugLabel": "", "toolDescription": "" }, { "key": "aiChatVision", "label": "", "valueType": "boolean", "renderTypeList": [ "hidden" ], "value": true, "debugLabel": "", "toolDescription": "" }, { "key": "aiChatReasoning", "label": "", "valueType": "boolean", "renderTypeList": [ "hidden" ], "value": true, "debugLabel": "", "toolDescription": "" }, { "key": "aiChatTopP", "label": "", "valueType": "number", "renderTypeList": [ "hidden" ], "debugLabel": "", "toolDescription": "" }, { "key": "aiChatStopSign", "label": "", "valueType": "string", "renderTypeList": [ "hidden" ], "debugLabel": "", "toolDescription": "" }, { "key": "aiChatResponseFormat", "label": "", "valueType": "string", "renderTypeList": [ "hidden" ], "debugLabel": "", "toolDescription": "", "value": "json_object" }, { "key": "aiChatJsonSchema", "label": "", "valueType": "string", "renderTypeList": [ "hidden" ], "debugLabel": "", "toolDescription": "", "value": "{\"type\": \"object\", \"additionalProperties\": false, \"required\": [\"worldview_summary\", \"era_background\", \"social_rules\", \"space_logic\", \"key_settings\", \"conflict_mechanisms\", \"visual_keywords\"], \"properties\": {\"worldview_summary\": {\"type\": \"string\", \"minLength\": 20}, \"era_background\": {\"type\": \"string\", \"minLength\": 5}, \"social_rules\": {\"type\": \"string\", \"minLength\": 5}, \"space_logic\": {\"type\": \"string\", \"minLength\": 5}, \"key_settings\": {\"type\": \"array\", \"minItems\": 3, \"items\": {\"type\": \"string\", \"minLength\": 5}}, \"conflict_mechanisms\": {\"type\": \"array\", \"minItems\": 3, \"items\": {\"type\": \"string\", \"minLength\": 5}}, \"visual_keywords\": {\"type\": \"array\", \"minItems\": 3, \"items\": {\"type\": \"string\", \"minLength\": 2}}}}" }, { "key": "systemPrompt", "label": "common:core.ai.Prompt", "valueType": "string", "isRichText": true, "placeholder": "common:core.app.tip.chatNodeSystemPromptTip", "maxLength": 100000, "renderTypeList": [ "textarea", "reference" ], "value": "你现在扮演“世界观生成编剧A”，负责根据用户已经提供的基础设定，生成完整世界观。\n\n请严格基于以下内容创作，用户输入是最高优先级，不得偏离、覆盖或重写用户原意。\n\n【故事大纲】\n{{$VARIABLE_NODE_ID.ayxWwSpE$}}\n\n【核心场景】\n{{$VARIABLE_NODE_ID.rxmvq2lS$}}\n\n【人物小传】\n{{$VARIABLE_NODE_ID.yYYOuumm$}}\n\n【分集计划】\n{{$VARIABLE_NODE_ID.pxtQY7p2$}}\n\n你的任务是生成一份完整的世界观设定。\n\n世界观内容必须覆盖：\n1. 世界观总述\n2. 时代背景\n3. 社会环境与运行规则\n4. 故事发生空间的底层逻辑\n5. 与人物命运相关的关键设定\n6. 与剧情冲突直接相关的规则、禁忌或机制\n7. 视觉与氛围关键词\n\n生成要求：\n- 不能脱离用户输入\n- 不能和人物、场景、分集计划冲突\n- 不要写剧本正文\n- 不要推进具体情节\n- 不要空泛堆砌设定\n- 所有内容使用中文\n- 输出必须是合法 JSON\n- 不要输出 JSON 之外的任何说明文字\n- 不要使用 markdown 代码块\n- 所有字段必须填写\n- key_settings 至少输出 3 条\n- conflict_mechanisms 至少输出 3 条\n- visual_keywords 至少输出 3 条\n- \n再次强调：最终回复必须且只能是一个合法 JSON 对象，禁止输出任何解释、标题、注释、代码块标记或多余文本。请严格输出为以下 JSON 结构：\n{\n \"worldview_summary\": \"对整个世界观的总体概述，1到3段中文\",\n \"era_background\": \"时代背景与宏观环境\",\n \"social_rules\": \"社会环境、秩序、运行规则、普遍共识或制度约束\",\n \"space_logic\": \"故事主要发生空间的底层逻辑，包括地点特征、空间规则、环境限制\",\n \"key_settings\": [\n \"与人物命运密切相关的关键设定1\",\n \"与人物命运密切相关的关键设定2\",\n \"与人物命运密切相关的关键设定3\"\n ],\n \"conflict_mechanisms\": [\n \"与剧情冲突直接相关的规则、禁忌或机制1\",\n \"与剧情冲突直接相关的规则、禁忌或机制2\",\n \"与剧情冲突直接相关的规则、禁忌或机制3\"\n ],\n \"visual_keywords\": [\n \"视觉或氛围关键词1\",\n \"视觉或氛围关键词2\",\n \"视觉或氛围关键词3\"\n ]\n}\n\n【强制格式兜底】\n- 最终输出必须能被 JSON.parse 直接解析。\n- 禁止输出 markdown、代码块、解释、标题、注释。\n- 禁止把字段名翻译成中文，禁止增加非契约字段，禁止遗漏字段。\n- 字符串字段不得为空；数组字段不得为空，且不得包含空字符串。\n", "debugLabel": "", "description": "common:core.app.tip.systemPromptTip", "toolDescription": "" }, { "key": "history", "label": "common:core.module.input.label.chat history", "valueType": "chatHistory", "required": true, "max": 50, "min": 0, "renderTypeList": [ "numberInput", "reference" ], "value": 0, "debugLabel": "", "description": "workflow:max_dialog_rounds", "toolDescription": "" }, { "key": "quoteQA", "label": "", "valueType": "datasetQuote", "renderTypeList": [ "settingDatasetQuotePrompt" ], "debugLabel": "知识库引用", "description": "", "toolDescription": "" }, { "key": "fileUrlList", "label": "app:workflow.user_file_input", "valueType": "arrayString", "renderTypeList": [ "reference", "input" ], "value": [ [ "448745", "userFiles" ] ], "debugLabel"