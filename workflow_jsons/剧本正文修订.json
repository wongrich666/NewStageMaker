{ "nodes": [ { "nodeId": "userGuide", "name": "common:core.module.template.system_config", "intro": "common:core.module.template.system_config_info", "avatar": "core/workflow/template/systemConfig", "flowNodeType": "userGuide", "position": { "x": 13260, "y": -1275 }, "version": "481", "inputs": [ { "key": "welcomeText", "label": "core.app.Welcome Text", "valueType": "string", "renderTypeList": [ "hidden" ], "value": "" }, { "key": "variables", "label": "core.app.Chat Variable", "valueType": "any", "renderTypeList": [ "hidden" ], "value": [] }, { "key": "questionGuide", "label": "core.app.Question Guide", "valueType": "any", "renderTypeList": [ "hidden" ], "value": { "open": false } }, { "key": "tts", "label": "", "valueType": "any", "renderTypeList": [ "hidden" ], "value": { "type": "web" } }, { "key": "whisper", "label": "", "valueType": "any", "renderTypeList": [ "hidden" ], "value": { "open": false, "autoSend": false, "autoTTSResponse": false } }, { "key": "scheduleTrigger", "label": "", "valueType": "any", "renderTypeList": [ "hidden" ], "value": null } ], "outputs": [] }, { "nodeId": "448745", "name": "common:core.module.template.work_start", "intro": "", "avatar": "core/workflow/template/workflowStart", "flowNodeType": "workflowStart", "position": { "x": 14025, "y": -1275 }, "version": "481", "inputs": [ { "key": "userChatInput", "label": "workflow:user_question", "valueType": "string", "required": true, "renderTypeList": [ "reference", "textarea" ], "debugLabel": "", "toolDescription": "用户问题" } ], "outputs": [ { "id": "userChatInput", "key": "userChatInput", "type": "static", "valueType": "string", "label": "common:core.module.input.label.user question", "description": "" } ] }, { "nodeId": "roBchMnqd4cL3NHh", "name": "五集正文修订编剧", "intro": "根据五集正文审核结果，对当前五集正文进行修订，重点修复承接、可拍性与服装版本 alias 命名一致性问题。", "avatar": "core/workflow/template/aiChat", "flowNodeType": "chatNode", "showStatus": true, "position": { "x": 14625, "y": -1231 }, "version": "4.9.7", "inputs": [ { "key": "model", "label": "common:core.module.input.label.aiModel", "valueType": "string", "renderTypeList": [ "settingLLMModel", "reference" ], "value": "deepseek-v4-flash", "debugLabel": "", "toolDescription": "" }, { "key": "temperature", "label": "", "valueType": "number", "renderTypeList": [ "hidden" ], "debugLabel": "", "toolDescription": "", "value": 0.6 }, { "key": "maxToken", "label": "", "valueType": "number", "renderTypeList": [ "hidden" ], "debugLabel": "", "toolDescription": "", "value": 64000 }, { "key": "isResponseAnswerText", "label": "", "valueType": "boolean", "renderTypeList": [ "hidden" ], "value": true, "debugLabel": "", "toolDescription": "" }, { "key": "aiChatQuoteRole", "label": "", "valueType": "string", "renderTypeList": [ "hidden" ], "value": "system", "debugLabel": "", "toolDescription": "" }, { "key": "quoteTemplate", "label": "", "valueType": "string", "renderTypeList": [ "hidden" ], "debugLabel": "", "toolDescription": "" }, { "key": "quotePrompt", "label": "", "valueType": "string", "renderTypeList": [ "hidden" ], "debugLabel": "", "toolDescription": "" }, { "key": "aiChatVision", "label": "", "valueType": "boolean", "renderTypeList": [ "hidden" ], "value": true, "debugLabel": "", "toolDescription": "" }, { "key": "aiChatReasoning", "label": "", "valueType": "boolean", "renderTypeList": [ "hidden" ], "value": true, "debugLabel": "", "toolDescription": "" }, { "key": "aiChatTopP", "label": "", "valueType": "number", "renderTypeList": [ "hidden" ], "debugLabel": "", "toolDescription": "" }, { "key": "aiChatStopSign", "label": "", "valueType": "string", "renderTypeList": [ "hidden" ], "debugLabel": "", "toolDescription": "" }, { "key": "aiChatResponseFormat", "label": "", "valueType": "string", "renderTypeList": [ "hidden" ], "debugLabel": "", "toolDescription": "" }, { "key": "aiChatJsonSchema", "label": "", "valueType": "string", "renderTypeList": [ "hidden" ], "debugLabel": "", "toolDescription": "" }, { "key": "systemPrompt", "label": "common:core.ai.Prompt", "valueType": "string", "isRichText": true, "placeholder": "common:core.app.tip.chatNodeSystemPromptTip", "maxLength": 100000, "renderTypeList": [ "textarea", "reference" ], "value": "你是“五集正文修订编剧”。\n\n你的任务不是做局部润色，而是把“当前批次这五集”修到真正能拍、能演、能承接、能推进。\n\n【当前批次边界】\n- 从第{{$VARIABLE_NODE_ID.d4sfifeZ$}}集开始。\n- 当前批次结束集数 = min(第{{$VARIABLE_NODE_ID.d4sfifeZ$}}集 + 4, {{$VARIABLE_NODE_ID.blkSS7dY$}})。\n- 只允许修这个区间内的连续集数。\n- 严禁扩写到当前批次之外。\n- 严禁跳集、漏集、重复集。\n- 如果原稿批次边界写错，你必须从第{{$VARIABLE_NODE_ID.d4sfifeZ$}}集开始重写正确批次。\n\n【输入】\n【世界观JSON】\n{{$VARIABLE_NODE_ID.yuozoGpo$}}\n【人设场景结果JSON】\n{{$VARIABLE_NODE_ID.fFM0mroW$}}\n【服装版本映射JSON】\n{{$VARIABLE_NODE_ID.h2KpLm91$}}\n【当前五集开头冲突钩子JSON】\n{{$VARIABLE_NODE_ID.hUoaaRhJ$}}\n【上五集剧本连贯性记忆存储】\n{{$VARIABLE_NODE_ID.dzt6kORx$}}\n【当前批次剧本正文】\n{{$VARIABLE_NODE_ID.zS2LXibg$}}\n【五集正文审核结果JSON】\n{{$VARIABLE_NODE_ID.m1uifNf9$}}\n【分集计划】\n{{$VARIABLE_NODE_ID.pxtQY7p2$}}\n\n【修订总目标】\n在不改变世界观、人物设定、服装版本映射、分集计划和主线成立条件的前提下，修掉 blocking_issues，让正文从“说明”变成“戏”，从“过程堆积”变成“结果推进”。\n\n【修订优先级】\n1. 先修批次边界和格式错误。\n2. 再修服装版本与命名一致性错误。\n3. 再修上下集承接错误。\n4. 再修人物行为不成立、关键选择缺触发。\n5. 再修小说化说明、不可拍动作、说明书式对白。\n6. 最后再修节奏、语言锋利度、钩子力度。\n\n【你必须落实的修订原则】\n- 输出的是修订后的完整当前批次正文，不是补丁说明。\n- 已成立的冲突链、承接链、关系链尽量保留，不要无故推倒重来。\n- 已成立的 alias 使用关系尽量保留，不要无故换名。\n- 但凡 blocking_issues 涉及“这一场戏无效 / 这一集不成立 / 承接断裂 / 命名漂移 / alias 错绑”，就必须果断重写，不要恋旧。\n- 修逻辑优先于修句子。\n- 修结果优先于修文采。\n- 修可拍性优先于修解释完整度。\n- 修命名一致性优先于语言花样。\n\n【如何使用服装版本映射JSON】\n- 只把它当成当前批次正文的人名白名单、触发规则表、切换规则表。\n- 必须优先修正以下问题：\n- 使用了映射外的新别名\n- 把 alias 错给了别的角色\n- 在必须使用 alias 的地方退回裸名\n- 同一场戏内部命名不统一\n- 发生换装/身份切换却没有写清触发点\n- canonical_name 只供你内部识别同一角色，最终输出仍应写 alias_name / default_name，不要把 canonical 解释写进正文。\n\n【如何使用联网参考】\n- 只把它当成语感、语域、职业/圈层/时代生活细节的补强材料。\n- 严禁照抄搜索结果原句。\n- 严禁因为搜索结果而改坏人物设定、题材调性、时代感、世界规则和服装版本映射规则。\n- 如果搜索结果没帮助，就忽略。\n\n【如何修“说明化”】\n- 把解释性文字压成动作、反应、对抗、结果。\n- 把“角色为什么这么做”的说明，改成触发过程、代价权衡、犹豫试探、失控反应。\n- 把“计划说明”改成争论、部署、质疑、临场变化，让观众通过听和看明白。\n- 把“背景说明”减到只剩理解当前冲突所必需的那部分。\n- 删除不改变局势的环境描写、情绪描写、走位描写。\n\n【如何修“人机味对白”】\n- 台词必须像现场能说出口的话。\n- 多用打断、顶嘴、逼问、反问、抢话、改口、回避、沉默后的补刀。\n- 同一场里，不同角色说话必须有身份差异、关系差异、情绪差异。\n- 能靠动作和反应解决的，不要堆成大段解释。\n- 【联网表达参考JSON】如果不为空，只能吸收语感、语域、语气动作和生活化表达规律，严禁照抄搜索结果原句。\n- 说话人标签必须回到本场合法 alias，不得自由漂移。\n\n【如何修“无效推进”】\n- 每场都要确认它改变了什么；什么都没改变就删或重写。\n- 每集都必须让观众看完后能回答：这一集到底新增了什么变化。\n- 不改变局势、关系、信息差、人物决心的内容，要么压缩，要么删除。\n\n【格式要求】\n- 只输出修订后的当前批次剧本正文。\n- 第一行必须从当前批次起始集开始，格式：\n- 每集内部场次头必须使用对应集数编号，例如：6-1 / 6-2 / 6-3。\n- 每集必须 2-3 个场次。\n- 动作行用“▲”开头。\n- 禁止输出 JSON、Markdown、解释、总结、审核意见。\n 第X集：第X集标题\nX-1\n人物：人物语言\n▲人物动作\nX-2\n...\nX-3\n...\n\n# 纯文本修订输出再强调\n你只能输出“修订后的完整当前批次剧本正文纯文本”。\n禁止输出 JSON、Markdown、代码块、解释、总结、审核意见、修订说明、补丁列表。\n第一行必须严格从“第{{$VARIABLE_NODE_ID.d4sfifeZ$}}集：”开始。\n每集必须包含至少一个对应集数的场次头，例如“{{$VARIABLE_NODE_ID.d4sfifeZ$}}-1”，场次头后面可以带场景名。\n不要在正文前加“以下是修订后的正文”“已根据意见修改”等前缀。\n如果原稿缺集、越界或格式错误，请直接重写正确批次正文，不要解释原因。\n", "debugLabel": "", "description": "common:core.app.tip.systemPromptTip", "toolDescription": "" }, { "key": "history", "label": "common:core.module.input.label.chat history", "valueType": "chatHistory", "required": true, "max": 50, "min": 0, "renderTypeList": [ "numberInput", "reference" ], "value": 0, "debugLabel": "", "description": "workflow:max_dialog_rounds", "toolDescription": "" }, { "key": "quoteQA", "label": "", "valueType": "datasetQuote", "renderTypeList": [ "settingDatasetQuotePrompt" ], "debugLabel": "知识库引用", "description": "", "toolDescription": "" }, { "key": "fileUrlList", "label": "app:workflow.user_file_input", "valueType": "arrayString", "renderTypeList": [ "reference", "input" ], "value": [ [ "448745", "userFiles" ] ], "debugLabel": "文件链接", "description": "app:workflow.user_file_input_desc", "toolDescription": "" }, { "key": "userChatInput", "label": "workflow:user_question", "valueType": "string", "required": true, "selectedTypeIndex": 1, "renderTypeList": [ "reference", "textarea" ], "value": "按照提示词完成当前的剧本正文修订任务即可。", "debugLabel": "", "toolDescription": "用户问题" } ], "outputs": [ { "id": "history", "key": "history", "type": "static", "valueType": "chatHistory", "valueDesc": "{\n obj: System | Human | AI;\n value: