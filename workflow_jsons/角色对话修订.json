{ "nodes": [ { "nodeId": "userGuide", "name": "系统配置", "intro": "可以配置应用的系统参数", "avatar": "core/workflow/template/systemConfig", "flowNodeType": "userGuide", "position": { "x": -90, "y": -1665 }, "version": "481", "inputs": [ { "key": "welcomeText", "label": "core.app.Welcome Text", "valueType": "string", "renderTypeList": [ "hidden" ], "value": "" }, { "key": "variables", "label": "core.app.Chat Variable", "valueType": "any", "renderTypeList": [ "hidden" ], "value": [] }, { "key": "questionGuide", "label": "core.app.Question Guide", "valueType": "any", "renderTypeList": [ "hidden" ], "value": { "open": false } }, { "key": "tts", "label": "", "valueType": "any", "renderTypeList": [ "hidden" ], "value": { "type": "web" } }, { "key": "whisper", "label": "", "valueType": "any", "renderTypeList": [ "hidden" ], "value": { "open": false, "autoSend": false, "autoTTSResponse": false } }, { "key": "scheduleTrigger", "label": "", "valueType": "any", "renderTypeList": [ "hidden" ], "value": null } ], "outputs": [] }, { "nodeId": "workflowStart", "name": "流程开始", "intro": "", "avatar": "core/workflow/template/workflowStart", "flowNodeType": "workflowStart", "position": { "x": 555, "y": -1605 }, "version": "481", "inputs": [ { "key": "userChatInput", "label": "workflow:user_question", "valueType": "string", "required": true, "renderTypeList": [ "reference", "textarea" ], "toolDescription": "用户问题", "debugLabel": "" } ], "outputs": [ { "id": "userChatInput", "key": "userChatInput", "type": "static", "valueType": "string", "label": "common:core.module.input.label.user question", "description": "" } ] }, { "nodeId": "dialogueRewriter", "name": "角色对白修订编剧", "intro": "根据审核意见重写完整对白版本，重点修复口语问题、人物同声与 alias 命名漂移。", "avatar": "core/workflow/template/aiChat", "flowNodeType": "chatNode", "showStatus": true, "position": { "x": 1305, "y": -1650 }, "version": "4.9.7", "inputs": [ { "key": "model", "label": "common:core.module.input.label.aiModel", "valueType": "string", "renderTypeList": [ "settingLLMModel", "reference" ], "value": "deepseek-v4-flash", "debugLabel": "", "toolDescription": "" }, { "key": "temperature", "label": "", "valueType": "number", "renderTypeList": [ "hidden" ], "value": 0.9, "debugLabel": "", "toolDescription": "" }, { "key": "maxToken", "label": "", "valueType": "number", "renderTypeList": [ "hidden" ], "value": 64000, "debugLabel": "", "toolDescription": "" }, { "key": "isResponseAnswerText", "label": "", "valueType": "boolean", "renderTypeList": [ "hidden" ], "value": true, "debugLabel": "", "toolDescription": "" }, { "key": "aiChatQuoteRole", "label": "", "valueType": "string", "renderTypeList": [ "hidden" ], "value": "system", "debugLabel": "", "toolDescription": "" }, { "key": "quoteTemplate", "renderTypeList": [ "hidden" ], "label": "", "valueType": "string", "debugLabel": "", "toolDescription": "" }, { "key": "quotePrompt", "renderTypeList": [ "hidden" ], "label": "", "valueType": "string", "debugLabel": "", "toolDescription": "" }, { "key": "aiChatVision", "label": "", "valueType": "boolean", "renderTypeList": [ "hidden" ], "value": true, "debugLabel": "", "toolDescription": "" }, { "key": "aiChatReasoning", "label": "", "valueType": "boolean", "renderTypeList": [ "hidden" ], "value": true, "debugLabel": "", "toolDescription": "" }, { "key": "aiChatTopP", "renderTypeList": [ "hidden" ], "label": "", "valueType": "number", "debugLabel": "", "toolDescription": "" }, { "key": "aiChatStopSign", "renderTypeList": [ "hidden" ], "label": "", "valueType": "string", "debugLabel": "", "toolDescription": "" }, { "key": "aiChatResponseFormat", "renderTypeList": [ "hidden" ], "label": "", "valueType": "string", "debugLabel": "", "toolDescription": "" }, { "key": "aiChatJsonSchema", "renderTypeList": [ "hidden" ], "label": "", "valueType": "string", "debugLabel": "", "toolDescription": "" }, { "key": "systemPrompt", "label": "common:core.ai.Prompt", "valueType": "string", "isRichText": true, "renderTypeList": [ "textarea", "reference" ], "value": "你是“角色对白修订编剧”。\n\n你的任务：\n基于当前角色对白 JSON 与审核结果 JSON，输出“完整新版本”，重点修复口语失真、人物同声、关系空转、戏剧功能压倒人物真实，以及 alias 使用不正确的问题。\n\n【修订边界】\n- 只能修当前批次，从第{{$VARIABLE_NODE_ID.dialogueStartEpisode$}}集开始\n- 一次最多五集，不得超过{{$VARIABLE_NODE_ID.totalEpisodes$}}集\n- 不能改分集大方向，不能改世界观底层规则，不能把人物改成另一类人\n- 你要改的是“说话方式、行为逻辑、命名执行”，不是只替换几个词\n- 输出命名必须服从当前 alias registry，不得自由重命名\n\n【命名修订依据】\n你必须按以下优先级修正当前版本中的人物命名：\n1. 服装版本映射JSON：{{$VARIABLE_NODE_ID.h2KpLm91$}}\n2. 场景结果JSON：{{$VARIABLE_NODE_ID.sceneContent$}}\n3. 当前五集开头冲突钩子JSON：{{$VARIABLE_NODE_ID.ayocjkj0$}}\n4. 分集计划JSON：{{$VARIABLE_NODE_ID.episodePlan$}}\n\n修订时必须遵守：\n- participants、dialogue_block.speaker、character_voice_bibles.alias_name、alias_binding.must_use_aliases 都必须使用当前允许的 alias_name\n- 禁止输出 registry 中不存在的别名\n- 禁止把同一 alias 绑定到错误角色\n- 当前场景要求使用 alias 时，禁止回退成“男主/女主/反派/医生/老板”等裸名或泛称\n- 同一场戏内同一角色的命名必须保持稳定\n- 角色声音仍然来自 canonical 本体，不要为了换名把人物写变形\n\n【修订原则】\n1. 优先修 blocking_issues\n2. 把“解释台词”改成“动作化台词”\n3. 把“作者句子”改成“角色句子”\n4. 把“剧情硬推”改成“人物在关系压力下自然做出选择”\n5. 保留已经成立的结构和有效冲突，不要为重写而重写\n6. alias 有误时，优先改命名与绑定，不要靠新增解释文字补漏洞\n\n【重点修复方向】\n- 让角色开口就能被区分\n- 让一句话同时带身份、关系、情绪\n- 允许不完整、不顺从、不讲理、打岔、顾左右而言他\n- 让关键冲突通过说话方式本身成立，而不是靠说明文字成立\n- 让当前批次所有出现的人名都与 alias registry 对齐\n\n【输入】\n【世界观JSON】\n{{$VARIABLE_NODE_ID.worldviewContent$}}\n【人设JSON】\n{{$VARIABLE_NODE_ID.characterContent$}}\n【场景结果JSON】\n{{$VARIABLE_NODE_ID.sceneContent$}}\n【服装版本映射JSON】\n{{$VARIABLE_NODE_ID.h2KpLm91$}}\n【分集计划JSON】\n{{$VARIABLE_NODE_ID.episodePlan$}}\n【当前角色对白JSON】\n{{$VARIABLE_NODE_ID.dialogueContent$}}\n\n【输出要求】\n- 只输出合法 JSON\n- 不要输出 JSON 之外的任何文字\n- 输出字段必须完整\n- 输出结构必须与原生成结构完全一致\n- speaker 字段只能填写 alias_name\n- 若 alias_binding 已要求 must_use_aliases，则整场必须执行，不得漂移\n# 契约字段强约束\n\n最终输出必须是合法 JSON。\n最外层必须且只能有一个字段：batch_dialogues。\n\nbatch_meta、character_voice_bibles、episode_dialogue_blocks 必须放在 batch_dialogues 内部。\n\n禁止在最外层输出以下字段：\n- totalEpisodes\n- episodePlan\n- worldviewContent\n- characterContent\n- sceneContent\n- hookContent\n- dialogueContent\n- dialogueReviewContent\n- dialogueSearchMemory\n- dialogueStartEpisode\n- dialogueMaxRewriteRounds\n- batch_meta\n- character_voice_bibles\n- episode_dialogue_blocks\n- dialogues\n- result\n- data\n这些都是输入变量或 legacy/random key，不是输出契约字段。请直接输出完整新版本 JSON。\n\n{\n \"batch_dialogues\": {\n \"batch_meta\": {\n \"start_episode\": 1,\n \"end_episode\": 5,\n \"batch_goal\": \"\",\n \"naming_principle\": \"\",\n \"bare_name_ban\": true\n },\n \"character_voice_bibles\": [],\n \"episode_dialogue_blocks\": []\n }\n}", "maxLength": 100000, "description": "common:core.app.tip.systemPromptTip", "placeholder": "common:core.app.tip.chatNodeSystemPromptTip", "debugLabel": "", "toolDescription": "" }, { "key": "history", "label": "common:core.module.input.label.chat history", "valueType": "chatHistory", "required": true, "max": 50, "min": 0, "renderTypeList": [ "numberInput", "reference" ], "value": 0, "description": "workflow:max_dialog_rounds", "debugLabel": "", "toolDescription": "" }, { "key": "quoteQA", "label": "", "valueType": "datasetQuote", "renderTypeList": [ "settingDatasetQuotePrompt" ], "debugLabel": "知识库引用", "description": "", "toolDescription": "" }, { "key": "fileUrlList", "label": "app:workflow.user_file_input", "valueType": "arrayString", "renderTypeList": [ "reference", "input" ], "value": [ [ "workflowStart", "userFiles" ] ], "debugLabel": "文件链接", "description": "app:workflow.user_file_input_desc", "toolDescription": "" }, { "key": "userChatInput", "label": "workflow:user_question", "valueType": "string", "required": true, "selectedTypeIndex": 1, "renderTypeList": [ "reference", "textarea" ], "value": "按照提示词完成角色对白修订任务即可。", "toolDescription": "用户问题", "debugLabel": "" } ], "outputs": [ { "id": "history", "key": "history", "type": "static", "valueType": "chatHistory", "label": "common:core.module.output.label.New context", "description": "将本次回复内容拼接上历史记录，作为新的上下文返回", "required": true, "valueDesc": "{\n obj: System | Human | AI;\n value: string;\n}[]" }, { "id": "answerText", "key": "answerText", "type": "static", "valueType": "string", "label": "common:core.module.output.label.Ai response content", "description": "将在 stream 回复完毕后触发", "required": true }, { "id": "reasoningText", "key": "reasoningText", "type": "static", "valueType": "string", "label": "workflow:reasoning_content", "description": "", "required": false, "invalid": false }, { "id": "system_error_text", "key": "system_error_text", "type": "error", "valueType": "string", "label": "workflow:error_text", "description": "" } ], "catchError": false }, { "nodeId": "updateDialogueContentFromRewriter", "name": "更新角色对白修订内容", "intro": "将修订结果写入角色对白内容变量", "avatar": "core/workflow/template/variableUpdate", "flowNodeType": "variableUpdate", "showStatus": false, "position": { "x": 2160, "y": -1620 }, "inputs": [ { "key": "updateList", "label": "", "valueType": "any", "renderTypeList": [ "hidden" ], "value": [ { "variable": [ "VARIABLE_NODE_ID", "dialogueContent" ], "value": [ "dialogueRewriter", "answerText" ], "valueType": "string", "renderType": "reference" } ], "debugLabel": "", "toolDescription": "" } ], "outputs": [] } ], "edges": [ { "source": "dialogueRewriter", "target": "updateDialogueContentFromRewriter", "sourceHandle": "dialogueRewriter-source-right", "targetHandle": "updateDialogueContentFromRewriter-target-left" }, { "source": "workflowStart", "target": "dialogueRewriter", "sourceHandle": "workflowStart-source-right", "targetHandle": "dialogueRewriter-target-left" } ], "chatConfig": { "variables": [ { "key": "totalEpisodes", "label": "总集数", "valueType": "number", "required": true, "defaultValue": 60, "max": 100, "min": 1, "type": "numberInput", "description": "用户要写的剧本总集数", "icon": "core/workflow/inputType/numberInput" }, { "key": "episodePlan", "label": "分集计划", "valueType": "string", "required": true, "defaultValue": "", "type": "input", "description": "按剧集拆解的分集计划 JSON 或文本", "icon": "core/workflow/inputType/input" }, { "type": "input", "key": "ayocjkj0", "label": "当前五集开头冲突钩子", "valueType": "string", "description": "", "required": false, "icon": "core/workflow/inputType/input" }, { "type": "input", "key": "worldviewContent", "label": "世界观内容", "valueType": "string", "description": "保存世界观最新版本", "required": false, "icon": "core/workflow/inputType/input" }, { "type": "input", "key": "characterContent", "label": "人设内容", "valueType": "string", "description": "保存人设最新版本", "required": false, "icon": "core/workflow/inputType/input" }, { "type": "input", "key": "sceneContent", "label": "场景内容", "valueType": "string", "description": "保存最新场景结果", "required": false, "icon": "core/workflow/inputType/input" }, { "type": "input", "key": "dialogueReviewContent", "label": "角色对白审核内容", "valueType": "string", "description": "当前批次最新审核 JSON", "required": false, "defaultValue": "", "icon": "core/workflow/inputType/input" }, { "type": "numberInput", "key": "dialogueStartEpisode", "label": "角色对白从这一集开始", "valueType": "number", "description": "当前批次起始集数", "required": false, "defaultValue": "1", "icon": "core/workflow/inputType/numberInput" }, { "type": "input", "key": "h2KpLm91", "label": "服装版本映射内容", "valueType": "string", "description": "保存最新撰写/修订的服装版本映射结构化JSON，用作当前批次角色对白的 alias registry。", "required": false, "defaultValue": "", "icon": "core/workflow/inputType/input" }, { "type": "internal", "key": "dialogueContent", "label": "角色对白内容", "valueType": "string", "description": "当前批次最新对白 JSON", "required": false, "defaultValue": "", "icon": "core/workflow/inputType/internal" } ], "scheduledTriggerConfig": { "cronString": "", "timezone": "Asia/Shanghai", "defaultPrompt": "" }, "_id": "69e754af7846cab59f6991b2" } }