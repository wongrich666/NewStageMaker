odule.input.label.aiModel", "valueType": "string", "renderTypeList": [ "settingLLMModel", "reference" ], "value": "deepseek-v4-pro", "debugLabel": "", "toolDescription": "" }, { "key": "temperature", "label": "", "valueType": "number", "renderTypeList": [ "hidden" ], "debugLabel": "", "toolDescription": "" }, { "key": "maxToken", "label": "", "valueType": "number", "renderTypeList": [ "hidden" ], "debugLabel": "", "toolDescription": "" }, { "key": "isResponseAnswerText", "label": "", "valueType": "boolean", "renderTypeList": [ "hidden" ], "value": true, "debugLabel": "", "toolDescription": "" }, { "key": "aiChatVision", "label": "", "valueType": "boolean", "renderTypeList": [ "hidden" ], "value": true, "debugLabel": "", "toolDescription": "" }, { "key": "aiChatReasoning", "label": "", "valueType": "boolean", "renderTypeList": [ "hidden" ], "value": true, "debugLabel": "", "toolDescription": "" }, { "key": "aiChatTopP", "label": "", "valueType": "number", "renderTypeList": [ "hidden" ], "debugLabel": "", "toolDescription": "" }, { "key": "aiChatStopSign", "label": "", "valueType": "string", "renderTypeList": [ "hidden" ], "debugLabel": "", "toolDescription": "" }, { "key": "aiChatResponseFormat", "label": "", "valueType": "string", "renderTypeList": [ "hidden" ], "debugLabel": "", "toolDescription": "" }, { "key": "aiChatJsonSchema", "label": "", "valueType": "string", "renderTypeList": [ "hidden" ], "debugLabel": "", "toolDescription": "" }, { "key": "useAgentSandbox", "label": "app:use_agent_sandbox", "valueType": "boolean", "renderTypeList": [ "switch" ], "value": false, "debugLabel": "", "description": "app:use_computer_desc", "toolDescription": "" }, { "key": "systemPrompt", "label": "common:core.ai.Prompt", "valueType": "string", "isRichText": true, "placeholder": "common:core.app.tip.chatNodeSystemPromptTip", "maxLength": 100000, "renderTypeList": [ "textarea", "reference" ], "value": "你是“分集计划规范化编排器”。\n用户输入即为分集计划。\n你的唯一任务：\n调用名为“分集计划规范化编剧”的工具，把【分集计划】整理成规范 JSON。\n\n这次规范化不只要整理剧情推进，还要提前把“人物服装切换规则 / alias 使用计划”结构化出来。\n\n执行要求：\n1. 只调用“分集计划规范化编剧”这个工具。\n2. 不要自己改写分集计划。\n3. 不要自己输出解释。\n4. 工具返回后立即结束。\n5. 当前工作流会自动把工具输出写入“规范化分集计划JSON”内部变量。\n\n最后你不需输出任何内容（如果无法做到不输出请你输出单个空格），禁止解释。你只需要调用工具完成任务即可。", "debugLabel": "", "description": "common:core.app.tip.systemPromptTip", "toolDescription": "" }, { "key": "history", "label": "common:core.module.input.label.chat history", "valueType": "chatHistory", "required": true, "max": 50, "min": 0, "renderTypeList": [ "numberInput", "reference" ], "value": 0, "debugLabel": "", "description": "workflow:max_dialog_rounds", "toolDescription": "" }, { "key": "fileUrlList", "label": "app:workflow.user_file_input", "valueType": "arrayString", "renderTypeList": [ "reference", "input" ], "value": [ [ "448745", "userFiles" ] ], "debugLabel": "文件链接", "description": "app:workflow.user_file_input_desc", "toolDescription": "" }, { "key": "userChatInput", "label": "workflow:user_question", "valueType": "string", "required": true, "renderTypeList": [ "reference", "textarea" ], "value": [ "VARIABLE_NODE_ID", "pxtQY7p2" ], "debugLabel": "", "toolDescription": "user question" } ], "outputs": [ { "id": "answerText", "key": "answerText", "type": "static", "valueType": "string", "valueDesc": "", "label": "common:core.module.output.label.Ai response content", "description": "将在 stream 回复完毕后触发" }, { "id": "system_error_text", "key": "system_error_text", "type": "error", "valueType": "string", "valueDesc": "", "label": "workflow:error_text", "description": "" } ], "catchError": false }, { "nodeId": "epPlanNormalizeChat", "name": "分集计划规范化编剧", "intro": "把原始分集计划按集拆分为结构化 JSON，同时提前整理角色服装切换规则与逐集 alias 使用计划。", "avatar": "core/workflow/template/aiChat", "flowNodeType": "chatNode", "showStatus": true, "position": { "x": -1320, "y": 1050 }, "version": "4.9.7", "inputs": [ { "key": "model", "label": "common:core.module.input.label.aiModel", "valueType": "string", "renderTypeList": [ "settingLLMModel", "reference" ], "value": "deepseek-v4-pro", "debugLabel": "", "toolDescription": "" }, { "key": "temperature", "label": "", "valueType": "number", "renderTypeList": [ "hidden" ], "debugLabel": "", "toolDescription": "" }, { "key": "maxToken", "label": "", "valueType": "number", "renderTypeList": [ "hidden" ], "debugLabel": "", "toolDescription": "" }, { "key": "isResponseAnswerText", "label": "", "valueType": "boolean", "renderTypeList": [ "hidden" ], "value": true, "debugLabel": "", "toolDescription": "" }, { "key": "aiChatQuoteRole", "label": "", "valueType": "string", "renderTypeList": [ "hidden" ], "value": "system", "debugLabel": "", "toolDescription": "" }, { "key": "quoteTemplate", "label": "", "valueType": "string", "renderTypeList": [ "hidden" ], "debugLabel": "", "toolDescription": "" }, { "key": "quotePrompt", "label": "", "valueType": "string", "renderTypeList": [ "hidden" ], "debugLabel": "", "toolDescription": "" }, { "key": "aiChatVision", "label": "", "valueType": "boolean", "renderTypeList": [ "hidden" ], "value": true, "debugLabel": "", "toolDescription": "" }, { "key": "aiChatReasoning", "label": "", "valueType": "boolean", "renderTypeList": [ "hidden" ], "value": true, "debugLabel": "", "toolDescription": "" }, { "key": "aiChatTopP", "label": "", "valueType": "number", "renderTypeList": [ "hidden" ], "debugLabel": "", "toolDescription": "" }, { "key": "aiChatStopSign", "label": "", "valueType": "string", "renderTypeList": [ "hidden" ], "debugLabel": "", "toolDescription": "" }, { "key": "aiChatResponseFormat", "label": "", "valueType": "string", "renderTypeList": [ "hidden" ], "debugLabel": "", "toolDescription": "" }, { "key": "aiChatJsonSchema", "label": "", "valueType": "string", "renderTypeList": [ "hidden" ], "debugLabel": "", "toolDescription": "" }, { "key": "systemPrompt", "label": "common:core.ai.Prompt", "valueType": "string", "isRichText": true, "placeholder": "common:core.app.tip.chatNodeSystemPromptTip", "maxLength": 100000, "renderTypeList": [ "textarea", "reference" ], "value": "你是“分集计划规范化编剧”。\n\n你的唯一任务：\n把【分集计划】原文整理为规范 JSON，方便后续代码和工作流按“集数”和“人物 alias”读取。\n你不是编剧，不是审核员，不是摘要器。\n\n【输入】\n【分集计划】\n{{$VARIABLE_NODE_ID.pxtQY7p2$}}\n【故事大纲】\n{{$VARIABLE_NODE_ID.ayxWwSpE$}}\n【人物小传】\n{{$VARIABLE_NODE_ID.yYYOuumm$}}\n【世界观JSON】\n{{$VARIABLE_NODE_ID.yuozoGpo$}}\n【命名偏好】\n{{$VARIABLE_NODE_ID.m3UxJ8pD$}}\n\n【这次新增职责】\n你除了要按“集”整理剧情计划，还要提前把“人物服装切换规则 / alias 使用计划”结构化出来。\n至少要整理出：\n1. 哪些角色存在多套造型或多种命名版本\n2. 切换按什么维度发生（长期阶段切换 / 场景切换 / 状态切换 / 身份切换）\n3. 哪些属于长期阶段切换\n4. 哪些属于场景切换\n5. 每一集主要该用哪个人物服装版本名或 alias\n\n【硬性要求】\n1. 只做结构化整理，不做剧情改写、不做润色、不做扩写、不做删减。\n2. 不得补充原文和其他输入中都没有根据的剧情信息。\n3. 必须按“集”拆分；不得把多集合并成一集，也不得把一集拆成多集。\n4. 允许识别不同写法，例如：\n - 第1集 / 第一集\n - EP1 / Episode 1\n - 1. / 1、 / 1：\n5. 如果某集标题能直接从原文中明确提取，就填入 title；提取不出来就填空字符串。\n6. content 必须保留该集原始计划的主体信息，不要写成摘要，不要改写措辞。\n7. 如果集数不连续、存在跳号、重复，也要照实输出，不要自动修正。\n8. 服装切换规则和 alias 使用计划只能基于【分集计划】【故事大纲】【人物小传】【世界观JSON】中能够成立的信息整理；如果依据不足，允许留空，不得硬编。\n9. 这个阶段只负责“切换规则与推荐 alias 的前置规划”，不负责生成完整服装描述，不负责替代后续“服装版本映射生成”阶段。\n10. 如果【命名偏好】非空，alias_name 的命名风格优先服从它；若为空，则默认使用“角色名（阶段/场景/状态）”的格式。\n11. 如果无法判断某一集主用 alias，就写空数组，不要猜。\n12. 只输出合法 JSON，不要输出解释，不要输出 markdown 代码块，不要输出额外文字。\n\n【输出 JSON 结构】\n{\n \"normalized_episode_plan\": {\n \"parsed_episode_count\": 0,\n \"appearance_alias_planning\": {\n \"planning_scope\": \"\",\n \"global_naming_style\": \"\",\n \"characters_with_multiple_variants\": [],\n \"global_rules\": [],\n \"uncertain_or_missing_items\": []\n },\n \"episodes\": []\n }\n}\n\n【字段要求】\n- parsed_episode_count：等于 episodes 数组长度\n- appearance_alias_planning.planning_scope：概括本次 alias 规划覆盖到什么层面，例如“按分集计划前置整理长期阶段切换与场景切换”\n- appearance_alias_planning.global_naming_style：写清本次推荐采用的命名方式\n- characters_with_multiple_variants：只写确有多套版本依据的角色；没有就输出空数组\n- switch_dimensions：只能写“长期阶段切换 / 场景切换 / 状态切换 / 身份切换”等真实成立的维度\n- long_term_stage_switches：写跨多集持续生效的版本切换\n- scene_based_switches：写进入某类场景或满足某类条件时切换的版本名\n- global_rules：写对整份分集计划都成立的 alias 使用规则\n- uncertain_or_missing_items：写清哪些角色或集数目前依据不足，留待后续“服装版本映射生成”阶段细化\n- episode：必须是数字\n- title：只能来自原文可明确提取的标题，否则为空字符串\n- content：保留该集原始计划内容的主体信息，禁止改写为摘要\n- main_character_aliases：填写本集主要角色建议使用的 alias；如果无法判断则输出空数组\n- switch_type：只能写“default / long_term_stage / scene_based / status_based / identity_based”之一\n- appearance_events：只写该集文本里能明确看出的服装、阶段、身份、场景切换事件；没有就空数组\n- long_term_stage_flags：写该集属于哪个长期阶段，例如“男主上班期”“女主黑化后阶段”；没有就空数组\n- scene_based_alias_hints：写本集内若进入某类场景时应优先考虑的 alias 提示；没有就空数组\n\n再次强调：\n1. 最终回复必须且只能是一个合法 JSON 对象。\n2. 不得编造完整服装细节。\n3. 不得替代后续服装版本映射阶段完成过细设计。\n4. 你的职责是“前置结构化规划”，不是“最终定稿”。", "debugLabel": "", "description": "common:core.app.tip.systemPromptTip", "toolDescription": "" }, { "key": "history", "label": "common:core.module.input.label.chat history", "valueType": "chatHistory", "required": true, "max": 50, "min": 0, "renderTypeList": [ "numberInput", "reference" ], "value": 0, "debugLabel": "", "description": "workflow:max_dialog_rounds", "toolDescription": "" }, { "key": "quoteQA", "label": "", "valueType": "datasetQuote", "renderTypeList": [ "settingDatasetQuotePrompt" ], "debugLabel": "知识库引用", "description": "", "toolDescription": "" }, { "key": "fileUrlList", "label": "app:workflow.user_file_input", "valueType": "arrayString", "renderTypeList": [ "reference", "input" ], "value": [ [ "448745", "userFiles" ] ], "debugLabel": "文件链接", "description": "app:workflow.user_file_input_desc", "toolDescription": "" }, { "key": "userChatInput", "label": "workflow:user_question", "valueType": "string", "required": true, "selectedTypeIndex": 1, "renderTypeList": [ "reference", "textarea" ], "value": "按照提示词完成分集计划规范化任务即可。", "debugLabel": "", "toolDescription": "用户问题" } ], "outputs": [ { "id": "history", "key": "history", "type": "static", "valueType": "chatHistory", "valueDesc": "{\n obj: System | Human | AI;\n value: string;\n}[]", "label": "common:core.module.output.label.New context", "description": "将本次回复内容拼接上历史记录，作为新的上下文返回", "required": true }, { "id": "answerText", "key": "answerText", "type": "static", "valueType": "string", "valueDesc": "", "label": "common:core.module.out