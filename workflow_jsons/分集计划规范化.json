ber", "required": false, "defaultValue": 1, "type": "internal", "description": "代码侧维护的当前处理集数计数器，默认从 1 开始。" }, { "key": "ayxWwSpE", "label": "故事大纲", "valueType": "string", "required": false, "defaultValue": "", "type": "input", "description": "用于辅助识别分集阶段变化、身份切换与服装版本切换依据。" }, { "key": "yYYOuumm", "label": "人物小传", "valueType": "string", "required": false, "defaultValue": "", "type": "input", "description": "用于辅助识别角色基础身份、主要人物与可成立的 alias 命名对象。" }, { "key": "yuozoGpo", "label": "世界观内容", "valueType": "string", "required": false, "defaultValue": "", "type": "internal", "description": "用于辅助判断阶段、身份与场景切换规则是否成立。" }, { "key": "m3UxJ8pD", "label": "命名偏好", "valueType": "string", "required": false, "defaultValue": "", "type": "input", "description": "可选。用于手动指定本轮 alias 的命名风格，例如“顾沉（上班）/顾沉（生活）”。留空时默认使用“角色名（阶段/场景/状态）”。" } ], "scheduledTriggerConfig": { "cronString": "", "timezone": "Asia/Shanghai", "defaultPrompt": "" }, "_id": "69ef1c8ef962df93355c2bb1" } }