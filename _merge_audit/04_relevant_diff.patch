+def _preview_return_object(value: Any, *, limit: int = 2400) -> str:
+    try:
+        return _truncate_text(repr(value), limit=limit)
+    except Exception:
+        try:
+            return _truncate_text(
+                json.dumps(value, ensure_ascii=False, default=str),
+                limit=limit,
+            )
+        except Exception:
+            return "<unprintable>"
