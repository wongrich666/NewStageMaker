+def _should_use_mock_backend(definition: FrameworkPlannerStageDefinition) -> bool:
+    configured = _env_bool("FRAMEWORK_PLANNER_USE_MOCK", default=False)
+    if configured:
+        return True
+    return not stage_has_real_backend(definition.stage)
