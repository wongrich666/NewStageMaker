+.fp-history-item small { display: block; color: #667085; font-size: 11px; line-height: 1.45; margin-top: 4px; }
+.fp-history-actions { display: flex; align-items: center; justify-content: flex-end; gap: 8px; flex-wrap: wrap; }
+.fp-footer { position: fixed; left: 248px; right: 0; bottom: 0; z-index: 20; display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 12px 20px; border-top: 1px solid var(--fp-border); background: rgba(255,255,255,.9); backdrop-filter: blur(10px); }
+.fp-footer-note { color: var(--fp-muted); font-size: 13px; }
+.fp-toast { position: fixed; right: 20px; bottom: 82px; z-index: 40; background: #111827; color: #fff; padding: 10px 13px; border-radius: 10px; box-shadow: var(--fp-shadow); font-size: 13px; }
+.fp-modal-mask { position: fixed; inset: 0; z-index: 50; background: rgba(17, 24, 39, .48); display: grid; place-items: center; padding: 20px; }
+.fp-modal { width: min(860px, 100%); max-height: 88vh; overflow: auto; background: #fff; border-radius: 16px; box-shadow: 0 24px 80px rgba(16,24,40,.25); padding: 18px; }
+.fp-modal-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; margin-bottom: 12px; }
+.fp-modal h2 { margin: 0 0 4px; font-size: 18px; }
+.fp-modal-sub { margin: 0; color: var(--fp-muted); font-size: 13px; }
+.fp-detail-list { display: grid; gap: 9px; margin-top: 12px; }
+.fp-detail-item { border: 1px solid var(--fp-border); background: var(--fp-soft); border-radius: 12px; padding: 12px; line-height: 1.7; }
+.fp-detail-item strong { display: block; margin-bottom: 4px; }
+.fp-inline-warning { border: 1px solid #fedf89; color: #93370d; background: #fffaeb; padding: 10px 12px; border-radius: 10px; margin-bottom: 14px; line-height: 1.7; }
+.fp-running-card {
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  gap: 14px;
+  border: 1px solid #cfd8ff;
+  background: linear-gradient(90deg, #f7f9ff, #ffffff);
+  color: var(--fp-text);
+  border-radius: 14px;
+  padding: 13px 14px;
+  margin: -2px 0 14px;
+  box-shadow: 0 8px 22px rgba(63, 95, 227, .08);
+  position: relative;
+  overflow: hidden;
+}
+.fp-running-card:before {
+  content: "";
+  position: absolute;
+  inset: 0;
+  background: linear-gradient(90deg, transparent, rgba(63, 95, 227, .08), transparent);
+  transform: translateX(-100%);
+  animation: fpSweep 1.8s ease-in-out infinite;
+  pointer-events: none;
+}
+.fp-running-main { display: flex; align-items: center; gap: 12px; min-width: 0; position: relative; z-index: 1; }
+.fp-running-main strong { display: block; margin-bottom: 3px; }
+.fp-running-main p { margin: 0; color: var(--fp-muted); line-height: 1.55; font-size: 13px; }
+.fp-running-spinner {
+  width: 28px;
+  height: 28px;
+  border: 3px solid #dbe3ff;
+  border-top-color: var(--fp-blue);
+  border-radius: 50%;
+  animation: fpSpin .8s linear infinite;
+  flex: 0 0 auto;
+}
+.fp-running-badge {
+  position: relative;
+  z-index: 1;
+  white-space: nowrap;
+  color: var(--fp-blue);
+  background: var(--fp-blue-soft);
+  border: 1px solid #cfd8ff;
+  border-radius: 999px;
+  padding: 5px 10px;
+  font-size: 12px;
+  font-weight: 700;
+}
+.fp-processing-banner { display: flex; align-items: center; gap: 10px; border: 1px solid #cfd8ff; background: #f5f7ff; color: var(--fp-blue); border-radius: 12px; padding: 11px 12px; margin-bottom: 14px; }
+.fp-spinner { width: 16px; height: 16px; border: 2px solid #cbd5ff; border-top-color: var(--fp-blue); border-radius: 50%; animation: fpSpin .8s linear infinite; flex: 0 0 auto; }
+
+@keyframes fpSpin {
+  to { transform: rotate(360deg); }
+}
+
+@keyframes fpSweep {
+  0% { transform: translateX(-100%); }
+  55%, 100% { transform: translateX(100%); }
+}
+
+@keyframes fpPulse {
+  0%, 100% { opacity: .35; transform: scale(.82); }
+  50% { opacity: 1; transform: scale(1); }
+}
+
+@media (max-width: 1100px) {
+  .fp-shell { grid-template-columns: 1fr; }
+  .fp-side { position: relative; height: auto; }
+  .fp-footer { left: 0; }
+  .fp-grid, .fp-grid.two, .fp-grid.three, .fp-beat-card-grid, .fp-story-grid, .fp-guide-grid, .fp-asset-toolbar, .fp-asset-item, .fp-history-item { grid-template-columns: 1fr; }
+  .fp-asset-actions { justify-content: flex-start; }
+  .fp-history-actions { justify-content: flex-start; }
+}
