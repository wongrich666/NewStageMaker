          "value": "{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"adaptation_guide\",\"display_text\"],\"properties\":{\"adaptation_guide\":{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"core_setting_adjustment\",\"narrative_rhythm_structure\",\"visualization\",\"character_emotion_shaping\",\"hard_constraints_for_script_workflow\"],\"properties\":{\"core_setting_adjustment\":{\"type\":\"string\",\"minLength\":1},\"narrative_rhythm_structure\":{\"type\":\"string\",\"minLength\":1},\"visualization\":{\"type\":\"string\",\"minLength\":1},\"character_emotion_shaping\":{\"type\":\"string\",\"minLength\":1},\"hard_constraints_for_script_workflow\":{\"type\":\"array\",\"minItems\":1,\"items\":{\"type\":\"string\",\"minLength\":1}}}},\"display_text\":{\"type\":\"string\",\"minLength\":1}}}"
