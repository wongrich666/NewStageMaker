          "value": "{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"character_plan\",\"display_text\"],\"properties\":{\"character_plan\":{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"character_system_summary\",\"characters\",\"relationship_map\",\"character_rules\"],\"properties\":{\"character_system_summary\":{\"type\":\"string\",\"minLength\":1},\"characters\":{\"type\":\"array\",\"minItems\":3,\"items\":{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"id\",\"name\",\"role\",\"identity\",\"external_goal\",\"internal_need\",\"weakness\",\"ability_or_resource\",\"growth_arc\",\"relationship_hooks\",\"story_function\",\"forbidden_write\"],\"properties\":{\"id\":{\"type\":\"string\",\"minLength\":1},\"name\":{\"type\":\"string\",\"minLength\":1},\"role\":{\"type\":\"string\",\"minLength\":1},\"identity\":{\"type\":\"string\",\"minLength\":1},\"external_goal\":{\"type\":\"string\",\"minLength\":1},\"internal_need\":{\"type\":\"string\",\"minLength\":1},\"weakness\":{\"type\":\"string\",\"minLength\":1},\"ability_or_resource\":{\"type\":\"string\",\"minLength\":1},\"growth_arc\":{\"type\":\"string\",\"minLength\":1},\"relationship_hooks\":{\"type\":\"array\",\"minItems\":1,\"items\":{\"type\":\"string\",\"minLength\":1}},\"story_function\":{\"type\":\"string\",\"minLength\":1},\"forbidden_write\":{\"type\":\"array\",\"minItems\":1,\"items\":{\"type\":\"string\",\"minLength\":1}}}}},\"relationship_map\":{\"type\":\"array\",\"minItems\":1,\"items\":{\"type\":\"string\",\"minLength\":1}},\"character_rules\":{\"type\":\"array\",\"minItems\":1,\"items\":{\"type\":\"string\",\"minLength\":1}}}},\"display_text\":{\"type\":\"string\",\"minLength\":1}}}",
